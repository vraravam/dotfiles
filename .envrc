#!/usr/bin/env bash
# .envrc for dotfiles repository development
#
# Activated by direnv when entering this directory.
# Adds system Ruby 2.6 user gems to PATH for static analysis tools.
#
# direnv runs this in a bash subshell -- source .shellrc unconditionally.

set -euo pipefail

# Signal to .shellrc that we're in a direnv context (info/success logs are suppressed)
export DIRENV_IN_ENVRC=1

# set -E ensures the ERR trap is inherited by functions called from this file.
set -E
trap 'echo "Error in ${BASH_SOURCE[0]##*/} (line ${LINENO})" "❌ direnv error"' ERR

export GEM_HOME="${HOME}/.gem/ruby/2.6.0"
export PATH="${GEM_HOME}/bin:./bin:/usr/bin/:${PATH}"

bundle check || bundle install --binstubs
bundler-audit check --update 1>/dev/null
