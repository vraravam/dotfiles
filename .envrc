#!/usr/bin/env bash
# .envrc for dotfiles repository development
#
# Activated by direnv when entering this directory.
# Adds system Ruby 2.6 user gems to PATH for static analysis tools.
#
# direnv runs this in a bash subshell -- source .shellrc unconditionally.

set -euo pipefail

# Signal to .shellrc that we're in a direnv context (info/success logs are suppressed)
export DIRENV_IN_ENVRC=1

source "${HOME}/.shellrc"

# set -E ensures the ERR trap is inherited by functions called from this file.
# _dotfiles_notify() (from .shellrc) triggers a macOS notification (terminal-notifier or osascript).
set -E
trap '_dotfiles_notify "Error in ${BASH_SOURCE[0]##*/} (line ${LINENO})" "❌ direnv error"' ERR

# Install gems (idempotent) - the script owns the list of gems and installs only what is
# missing. First run: ~2 minutes (installs gems). Every later run returns immediately
# and silently once it sees that all of them are present.
# A failure here (e.g. a native extension that cannot compile because the Xcode Command
# Line Tools are incomplete) must not abort this file under 'set -e': the gems are optional
# lint tooling, so say so on stderr (which direnv shows; 'warn' is silenced in this context
# and stdout is discarded) and carry on. The script itself prints the diagnosis.
gem_install_script="${PWD}/scripts/install-ruby26-gems.rb"
if is_executable "${gem_install_script}"; then
  if ! "${gem_install_script}" >&2; then
    echo "$(yellow 'direnv'): static-analysis gems are incomplete -- see the messages above; continuing without them" >&2
  fi
fi

# Add gem bin directory to PATH (only if it exists)
gem_bin_dir="${HOME}/.gem/ruby/2.6.0/bin"
if is_directory "${gem_bin_dir}"; then
  PATH_add "${gem_bin_dir}"
fi
