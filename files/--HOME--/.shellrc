#!/usr/bin/env zsh

# vim:filetype=zsh syntax=zsh tabstop=2 shiftwidth=2 softtabstop=2 expandtab autoindent fileencoding=utf-8

################################################################################
# This file is sourced by all shells. It is used to define the bare minimum shell
# functions and env vars that are needed during bootstrap of a vanilla OS to
# bootstrap installation of all other config files.
# Functions that are only needed in interactive sessions and depend on DOTFILES_DIR
# or other post-clone env vars should live in .aliases instead.
#
# BASH COMPATIBILITY: this file must remain not just bash-*parseable* but
# bash-*functionally correct* -- direnv sources it in a bash subshell (see
# .envrc), and any script may 'source ~/.shellrc' directly from bash. Zsh-only
# syntax falls into three failure classes when bash encounters it, from most
# to least dangerous: (1) silently wrong with no error at all (e.g. ${var:A},
# path+=/fpath+=, $EPOCHSECONDS/strftime) -- the most dangerous, since nothing
# looks broken; (2) parses fine, fails only if actually executed (e.g. ${+var},
# ${(P)name}, arr[-1], typeset -A) -- safe to guard with 'if is_zsh; then ...
# fi'; (3) breaks bash's own parser even inside a never-called function (e.g.
# '[[ -v "arr[key]" ]]') -- an is_zsh guard does NOT help here; the construct
# must be avoided entirely in this file. See shell-scripting.md's "Bash
# Compatibility Gotchas Discovered in .shellrc" section for the full catalog
# and the portable replacement used for each one.
#
# file location: ${HOME}/.shellrc
# load order: .zshenv [.shellrc], .zshrc [.shellrc, .aliases [.shellrc]], .zlogin
################################################################################

# Guard against re-sourcing -- all call sites can unconditionally 'source ~/.shellrc'
# without needing their own check. This return is a no-op cost (single builtin).
# ZSH_VERSION guard ensures the zsh-only '(( $+functions[...] ))' syntax is never
# evaluated by non-zsh runtimes (e.g. direnv's bash sandbox).
if [[ -n "${ZSH_VERSION-}" ]] && (($+functions[is_shellrc_sourced])); then
  return
fi

# Dummy function to check if shellrc is sourced (mirrors is_aliases_sourced in .aliases)
# Defined immediately after the guard so that any subsequent 'source ~/.shellrc' in zsh
# returns before re-executing env vars, exports, and function definitions below.
is_shellrc_sourced() {
  return 0
}

# execute 'DEBUG=true zsh' to debug the load order of the custom zsh configuration files
if [[ -n "${DEBUG:-}" ]]; then echo "loading ${0}"; fi

# BASH_VERSION is set by bash but unset in zsh. Any third-party script sourced
# from here (e.g. antidote.zsh) that checks ${BASH_VERSION} bare will crash under
# set -u with "parameter not set". Pre-set to empty once here so all downstream
# sources are safe without needing per-callsite workarounds.
BASH_VERSION="${BASH_VERSION:-}"

export XDG_BIN_HOME="${XDG_BIN_HOME:-"${HOME}/.local/bin"}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-"${HOME}/.cache"}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-"${HOME}/.config"}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-"${HOME}/.local/share"}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-"${HOME}/.local/state"}"
export ZDOTDIR="${ZDOTDIR:-"${XDG_CONFIG_HOME}/zsh"}"

# Tool configuration/state/history file locations (XDG compliance-equivalent so as to declutter ${HOME})
export HISTFILE="${XDG_STATE_HOME}/zsh/history"
export INPUTRC="${XDG_CONFIG_HOME}/readline/inputrc"
export PSQLRC="${XDG_CONFIG_HOME}/pg/psqlrc"
export PYTHONHISTORY="${XDG_STATE_HOME}/python/history"
export SQLITE_HISTORY="${XDG_STATE_HOME}/sqlite/history"

# zsh/datetime provides $EPOCHSECONDS (used by print_script_start, current_timestamp, etc).
# This is the ONLY place we load it - works for interactive shells (via .zshrc sourcing
# .shellrc) and scripts (which source .shellrc directly). zmodload doesn't propagate from
# .zshenv to scripts run via shebang, so .zshenv doesn't load it anymore.
# Safe to call multiple times - zmodload is idempotent. Guard prevents bash errors.
if [[ -n "${ZSH_VERSION-}" ]]; then
  zmodload zsh/datetime 2>/dev/null || true
fi

# Memoization cache for _log_indent: associative array depth -> indent string.
# Avoids repeated printf calls for the same depth. Zsh associative arrays are
# only available in zsh; guard with ZSH_VERSION check for bash compatibility
# (direnv sources this file in bash subshell).
if [[ -n "${ZSH_VERSION-}" ]]; then
  typeset -A _INDENT_CACHE
fi

# Note: Change these as per your settings. Removing or commenting out a variable
# will leave it unset in all shells started after the next login, which will cause
# any alias, script, or operation that depends on it to be silently skipped.

# ------------ Customizable env vars (MUST BE CHANGED to your values) ------------
# The github username where the setup scripts are downloaded from
export GH_USERNAME='vraravam'

# Keybase username (comment out if you don't use Keybase)
export KEYBASE_USERNAME='avijayr'
# --------------------------------------------------------------------------------

# ---------- Env vars for basic/common setup (can be optionally changed) ---------
# This repo is cloned into this location
export DOTFILES_DIR="${XDG_CONFIG_HOME}/dotfiles"

# Branch name of the dotfiles repo that's to be used for testing PR changes before merging
export DOTFILES_BRANCH='master'

# All development codebases are cloned into a subfolder of this folder
export PROJECTS_BASE_DIR="${HOME}/dev"

# Executable scripts that are not shared as part of this public repo are present here
export PERSONAL_BIN_DIR="${HOME}/personal/dev/bin"

# Many configuration files (eg `.envrc`, `.tool-versions`), that might contain sensitive info and so cannot be committed into those repos are stored here and symlinked to their target destination
export PERSONAL_CONFIGS_DIR="${HOME}/personal/dev/configs"

# All browser profiles are captured in this folder (might contain sensitive info like browsing history and so is considered private)
# Use ${USER} (zsh/PAM builtin) instead of $(whoami) to avoid forking a subprocess on every shell start.
export PERSONAL_PROFILES_DIR="${HOME}/personal/${USER}/browser-profiles"

# Keybase home repo name (comment out if you don't use Keybase)
export KEYBASE_HOME_REPO_NAME='home'

# Keybase profiles repo name (comment out if you don't use Keybase)
export KEYBASE_PROFILES_REPO_NAME='profiles'
# --------------------------------------------------------------------------------

# ------------- Env vars for upstream setup (SHOULD NOT be changed) --------------
# Github username for setting upstream remote
export UPSTREAM_GH_USERNAME='vraravam' # Note: DO NOT CHANGE THIS
# --------------------------------------------------------------------------------

export LANG='en_US.UTF-8'
# Setting LC_ALL overrides all other LC_* variables.
# LANG is kept as a fallback.
export LC_ALL='en_US.UTF-8'
export LESSCHARSET='utf-8'

# MACHTYPE is not used here: on a vanilla macOS (Apple Silicon) it incorrectly
# reports 'x86_64' instead of 'arm64' -- a confirmed zsh/macOS bug discussed in
# Apple support forums. uname -m is the only reliable source on all machines.
# Cache architecture detection to avoid uname -m fork on every .shellrc source.
# Cached in XDG_CACHE_HOME, invalidated by delete_caches (e.g. after macOS upgrades).
# This runs before HOMEBREW_PREFIX setup, which depends on ARCH.
# Note: XDG_CACHE_HOME is defined earlier in this file, but the directory may not exist
# yet during .zshenv (first source on vanilla OS). Cache write is guarded; cache read
# works regardless. Saves ~2-3ms per shell startup.
if [[ -z "${ARCH:-}" ]]; then
  local arch_cache="${XDG_CACHE_HOME}/arch-cache.zsh"
  if [[ -f "${arch_cache}" ]]; then
    source "${arch_cache}"
  else
    ARCH="$(uname -m)"
    # Guard cache write: XDG_CACHE_HOME dir may not exist yet during .zshenv on vanilla OS
    if [[ -d "${XDG_CACHE_HOME}" ]]; then
      {
        echo "export ARCH='${ARCH}'"
        echo "# Generated: $(uname -r)"
      } >|"${arch_cache}" 2>/dev/null
    fi
    export ARCH
  fi
fi
export ARCHFLAGS="-arch ${ARCH}"

# Moving homebrew env vars here itself so that the initial homebrew installation
# on a vanilla OS can be done/applied into memory immediately
case "${ARCH}" in
  *arm*)
    export HOMEBREW_PREFIX='/opt/homebrew'
    ;;
  *)
    export HOMEBREW_PREFIX='/usr/local'
    ;;
esac

# Prepend Homebrew to PATH immediately (no subprocess fork -- just a string
# concat) so every context that sources .shellrc directly (cron jobs, scripts,
# direnv's bash subshell, non-interactive/non-login shells) gets Homebrew-first
# PATH ordering, not just full interactive login shells.
#
# Without this, 'brew doctor' reports "/usr/bin occurs before /opt/homebrew/bin
# in your PATH" for any such context, since only .zshrc (interactive shells)
# previously ran the richer 'brew shellenv' caching mechanism below. That
# mechanism still runs for interactive shells and supersedes this -- the final
# 'typeset -gU ... PATH path ...' in .zshrc dedupes the resulting PATH, so this
# early prepend is harmless (not just redundant) when .zshrc runs afterward.
export PATH="${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:${PATH}"

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ASK=1
export HOMEBREW_CLEANUP_MAX_AGE_DAYS=3
export HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=3
export HOMEBREW_BAT=1
export HOMEBREW_VERBOSE_USING_DOTS=1
export HOMEBREW_BUNDLE_FILE="${HOME}/Brewfile"
export HOMEBREW_BUNDLE_FILE_GLOBAL="${HOME}/Brewfile"
export HOMEBREW_NO_ENV_HINTS=1
# Note: If the number and size of downloads is large - allow up to 1hr for any single curl transfer.
export HOMEBREW_CURL_EXTRA_CURL_ARGS='--connect-timeout 300 --max-time 3600'
# TODO: Uncomment once this feature has stabilized
# export HOMEBREW_VERIFY_ATTESTATIONS=1

# Antidote plugin manager home -- set explicitly so it is available before antidote.zsh
# is sourced (e.g. in .zlogin). Mirrors antidote's own platform defaults (see get_dir()
# in antidote.zsh): ~/Library/Caches/antidote on macOS, ${XDG_CACHE_HOME}/antidote on Linux.
# Note: is_macos is not yet defined here; use ${OSTYPE} directly.
case "${OSTYPE}" in
  *darwin*)
    export ANTIDOTE_HOME="${HOME}/Library/Caches/antidote"
    ;;
  *)
    export ANTIDOTE_HOME="${XDG_CACHE_HOME}/antidote"
    ;;
esac
export ANTIDOTE_ZSH="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"
export ANTIDOTE_PLUGIN_ZSH="${XDG_CONFIG_HOME}/zsh/plugins.zsh"
export ANTIDOTE_PLUGIN_TXT="${XDG_CONFIG_HOME}/zsh/plugins.txt"

# --------------------------------------------------------------------------
# GROUP 1: Bootstrap Utilities
# Available immediately after .shellrc is sourced on a vanilla OS.
# Used by fresh-install-of-osx.sh during first-time installation before the
# dotfiles repo is cloned and before .aliases is loaded.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# 1a. Shell state & basic predicates
# --------------------------------------------------------------------------

# Returns true if $1 is empty or unset.
is_zero_string() {
  if [[ -z "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if $1 is non-empty.
is_non_zero_string() {
  if [[ -n "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if the array named $1 has no elements.
# ${(P)1} (zsh indirect-parameter expansion) has no bash equivalent syntax; the
# bash fallback uses eval to build the same indirect array-length lookup --
# portable back to bash 3.2 (macOS's default -- no namerefs, no associative
# arrays). Confirmed empirically: bash's parser tokenizes ${(P)1} fine (unlike
# '-v "arr[key]"', which fails at parse time -- see shell-scripting.md), it only
# fails with 'bad substitution' when actually expanded at runtime, so a plain
# runtime is_zsh guard (not a separate never-called function) is sufficient here.
is_empty_array() {
  if is_zsh; then
    if ((${#${(P)1}[@]} == 0)); then
      return 0
    else
      return 1
    fi
  else
    local _count
    eval "_count=\${#${1}[@]}"
    [[ "${_count}" -eq 0 ]]
  fi
}

# Returns true if the array named $1 has at least one element.
is_non_empty_array() {
  if is_zsh; then
    if ((${#${(P)1}[@]} > 0)); then
      return 0
    else
      return 1
    fi
  else
    local _count
    eval "_count=\${#${1}[@]}"
    [[ "${_count}" -gt 0 ]]
  fi
}

# Prints (via stdout) the last element of the array named $1. Empty output if
# the array is empty. Zsh arrays are 1-indexed with native negative-index
# support ('[-1]'); bash's default /bin/bash (3.2, macOS) predates negative
# indices (added in bash 4.3) and is 0-indexed, so 'last index' is computed as
# count-1 instead. Used by step_end below as a portable stack "peek".
_array_last() {
  if is_zsh; then
    print -r -- "${${(P)1}[-1]}"
  else
    eval "printf '%s' \"\${${1}[\$((\${#${1}[@]} - 1))]}\""
  fi
}

# Removes the last element from the array named $1 in place (a stack "pop").
# Zsh: reslice to drop the last element ('[1,-2]' = everything except the
# last). Bash: 'unset' the highest-index element directly -- safe even though
# it can leave a "hole" in the underlying index sequence, because bash's
# "${arr[@]}" and "${#arr[@]}" only ever consider populated indices, not the
# raw index range.
_array_pop_last() {
  if is_zsh; then
    eval "${1}=(\"\${(@)${1}[1,-2]}\")"
  else
    eval "unset '${1}[\$((\${#${1}[@]} - 1))]'"
  fi
}

# Returns true if stdin is a TTY, or if FORCE_COLOR is set (used to enable color
# output in non-TTY subshells such as direnv or CI pipelines).
is_running_in_tty() {
  if [[ -t 0 ]] || is_non_zero_string "${FORCE_COLOR:-}"; then
    return 0
  else
    return 1
  fi
}

# Joins array elements into a bulleted list string, each on a new line with
# depth-aware indent + N levels, '- ' prefix, and single quotes around each item.
# Usage: join_array <array_name> [level]
# Example: join_array my_arr     # defaults to level 1
#          join_array my_arr 2   # level 2 (extra indentation)
#
# The indent is depth-aware (current script depth) + level subordination, matching
# Ruby's join_array behavior. Level defaults to 1 for standard label + list pattern.
#
# Output at depth 1, level 1: "  - 'item1'\n  - 'item2'"
# Output at depth 2, level 1: "    - 'item1'\n    - 'item2'"
# Output at depth 1, level 2: "    - 'item1'\n    - 'item2'"
join_array() {
  local _array_name="${1:?join_array: array name required}"
  local -a arr
  if is_zsh; then
    arr=("${(@P)_array_name}")
  else
    # Bash (even old 3.2, no namerefs): indirect array copy via eval. Standard
    # array building/iteration below (+=, "${arr[@]}") is portable as-is --
    # only the indirect *reference by name* needs a bash-specific path.
    eval "arr=(\"\${${_array_name}[@]}\")"
  fi
  if is_empty_array arr; then return; fi

  local level="${2:-1}"
  # Compute indentation: base depth + level subordination.
  # Base depth is captured at construction time, ensuring the list indents
  # correctly even if parent message is printed at a different depth later
  # (e.g., deferred warnings). All lines in multi-line messages must have their
  # own indentation baked in since logging functions only indent the first line.
  local base_indent="$(_log_indent)$(printf '%*s' $((level * 2)) '')"

  # Build formatted array with indent prefix, quotes, then join with newlines
  local -a formatted=()
  local item
  for item in "${arr[@]}"; do
    formatted+=("${base_indent}- '${item}'")
  done
  # printf (not zsh's '${(j:\n:)formatted}') -- confirmed byte-for-byte identical
  # output in both shells, so no is_zsh branch needed here.
  printf '%s\n' "${formatted[@]}"
}

# Returns true if the current shell is zsh.
# ${ZSH_VERSION-} uses the '-' operator: if ZSH_VERSION is unset, substitute
# empty string; if set (even to empty), use its value. Combined with -n, this
# is true only when ZSH_VERSION is set AND non-empty -- which is always the case
# when running inside zsh, since zsh unconditionally sets it to a version string.
is_zsh() {
  if [[ -n "${ZSH_VERSION-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Replaces the value of HOME with '~' to shorten displayed paths.
# Pure-zsh parameter expansion -- no subprocess fork.
#
# Color functions apply tilde substitution automatically via _colorize, so any
# path passed through a color function is display-ready without an explicit call
# here. Call this explicitly only for:
#   - Bare echo/printf call sites that display paths WITHOUT a color wrapper.
#   - Plain-text segments in section headers (not passed through a color function).
#
# NOTE: when searching for all substitution sites, also grep for '_colorize' --
# it centralises the inline expansion ${2//${HOME}/~} (see comment there for why
# it is inlined rather than calling this function).
replace_home_with_tilde() {
  echo "${1:-//${HOME}/~}"
}

# --------------------------------------------------------------------------
# 1b. Terminal colors
# --------------------------------------------------------------------------

# Do not use colors if there's no terminal
if ! is_running_in_tty; then
  NC=''
  BLACK=''
  DARK_GRAY=''
  RED=''
  LIGHT_RED=''
  GREEN=''
  LIGHT_GREEN=''
  ORANGE=''
  YELLOW=''
  BLUE=''
  LIGHT_BLUE=''
  PURPLE=''
  LIGHT_PURPLE=''
  CYAN=''
  LIGHT_CYAN=''
  LIGHT_GRAY=''
  WHITE=''
else
  # Variables are assigned as $'\e[...' literals -- avoids $(colorize ...) subshell
  # forks on every shell start.
  NC=$'\e[0m'         # No Color
  BLACK=$'\e[0;30m'
  DARK_GRAY=$'\e[1;30m'
  RED=$'\e[0;31m'
  LIGHT_RED=$'\e[1;31m'
  GREEN=$'\e[0;32m'
  LIGHT_GREEN=$'\e[1;32m'
  ORANGE=$'\e[0;33m'
  YELLOW=$'\e[1;33m'
  BLUE=$'\e[0;34m'
  LIGHT_BLUE=$'\e[1;34m'
  PURPLE=$'\e[0;35m'
  LIGHT_PURPLE=$'\e[1;35m'
  CYAN=$'\e[0;36m'
  LIGHT_CYAN=$'\e[1;36m'
  LIGHT_GRAY=$'\e[0;37m'
  WHITE=$'\e[1;37m'
fi

# Single implementation point for all color functions -- mirrors the private
# colorize() method in string.rb. Wraps in ANSI
# codes; public color functions below are one-line delegators.
# $1 = ANSI color variable (e.g. ${YELLOW}), $2 = string to colorize.
# Usage: _colorize <color_var> <string>
#
# Tilde substitution is performed by top-level logging functions to avoid
# redundant substitutions across multiple colored segments in a single message.
_colorize() { printf "${1:-}${2:-}${NC}"; }

# Color functions -- ordered by ANSI SGR code (matches variable declarations above).
black()        { _colorize "${BLACK}"        "${1:-}"; }
dark_gray()    { _colorize "${DARK_GRAY}"    "${1:-}"; }
red()          { _colorize "${RED}"          "${1:-}"; }
light_red()    { _colorize "${LIGHT_RED}"    "${1:-}"; }
green()        { _colorize "${GREEN}"        "${1:-}"; }
light_green()  { _colorize "${LIGHT_GREEN}"  "${1:-}"; }
orange()       { _colorize "${ORANGE}"       "${1:-}"; }
yellow()       { _colorize "${YELLOW}"       "${1:-}"; }
blue()         { _colorize "${BLUE}"         "${1:-}"; }
light_blue()   { _colorize "${LIGHT_BLUE}"   "${1:-}"; }
purple()       { _colorize "${PURPLE}"       "${1:-}"; }
light_purple() { _colorize "${LIGHT_PURPLE}" "${1:-}"; }
cyan()         { _colorize "${CYAN}"         "${1:-}"; }
light_cyan()   { _colorize "${LIGHT_CYAN}"   "${1:-}"; }
light_gray()   { _colorize "${LIGHT_GRAY}"   "${1:-}"; }
white()        { _colorize "${WHITE}"        "${1:-}"; }

# Logging functions are pure formatters: prefix + message. They do NOT apply
# tilde substitution. Any path in the message must be passed through a color
# function (yellow/cyan/etc.) which applies substitution automatically, or
# through replace_home_with_tilde for uncolored plain-text path segments.
# Usage: success|info|warn|debug <message>

# Send a macOS notification center alert. Safe to call even if osascript is absent.
# Strips ANSI escape codes from the message before passing to osascript -- osascript
# has no terminal and would display raw escape sequences as literal characters.
# Named with leading underscore to avoid collision with any system or plugin command
# named 'notify' (e.g. mise's command_not_found_handler) which would return 127
# and trigger the ERR trap in cron scripts.
# Usage: _dotfiles_notify <message> [title]
_dotfiles_notify() {
  local _msg="${1:-}"
  local _title="${2:-Dotfiles}"

  # Strip ANSI codes using shared helper (avoids subshell fork that would trigger ERR trap)
  _msg="$(_strip_ansi "${_msg}")"

  # Prefer Ruby implementation (single source of truth) if available (post-bootstrap).
  # Fall back to shell implementation for vanilla OS / bootstrap phase.
  if command_exists ruby && is_file "${DOTFILES_DIR}/scripts/utilities/macos.rb"; then
    # Delegate to Ruby MacOS.notify (terminal-notifier with osascript fallback)
    # Uses call_ruby_utility for proper RUBYLIB setup and error handling
    # Escape single quotes in message and title for Ruby string safety
    local _msg_escaped="${_msg//\'/\'\\\'\'}"
    local _title_escaped="${_title//\'/\'\\\'\'}"
    call_ruby_utility "require 'macos'; MacOS.notify('${_msg_escaped}', '${_title_escaped}')" 2>/dev/null || true
  elif command_exists terminal-notifier; then
    # Shell fallback: terminal-notifier for richer notifications
    terminal-notifier -message "${_msg}" -title "${_title}" -sound default 2>/dev/null || true
  elif is_executable '/usr/bin/osascript'; then
    # Shell fallback: osascript (always available on vanilla OS)
    osascript -e "display notification \"${_msg}\" with title \"${_title}\"" 2>/dev/null || true
  fi
}

# Returns true if logging should be suppressed in the current context.
# Currently checks if running inside a direnv subshell, where most logging
# is unwanted noise. Future extensions: CI environment checks, log level filtering.
# DIRENV_IN_ENVRC=1 is set by direnv during .envrc evaluation and survives
# strict_env (unlike DIRENV_DIR). Used by info/success/warn/user_action/debug.
# error() always prints regardless of context -- critical failures must be visible.
_should_suppress_log() {
  is_non_zero_string "${DIRENV_IN_ENVRC:-}"
}

# Returns the depth-based indent string (2 spaces per depth level).
# Used by all logging functions to auto-indent output based on script nesting.
# Memoized to avoid repeated printf calls for the same depth.
_log_indent() {
  local depth="${_DOTFILES_SCRIPT_DEPTH:-1}"
  # Guard against depth 0 (called before increment_script_depth) - treat as depth 1
  # to prevent negative multiplication. This can happen when print_script_summary
  # decrements depth before calling section_header. Default to 1 if unset.
  [[ ${depth} -lt 1 ]] && depth=1
  # _INDENT_CACHE (associative array) is a zsh/bash-4+ feature -- macOS's
  # default /bin/bash (3.2, no Homebrew bash guaranteed in PATH) doesn't
  # support it, so this whole function must branch. The zsh path keeps the
  # memoization (this runs on every log call in the interactive hot path);
  # the bash fallback recomputes directly each call -- acceptable since
  # direnv/.envrc logging is far less frequent.
  #
  # Note: uses '-z "${...:-}"' (emptiness), not the '-v' test operator, to
  # check whether the cache entry is already populated. '-v' is itself a
  # bash-4.2+/zsh feature -- unlike 'setopt'/'autoload' (runtime-only zsh
  # commands that bash's parser tokenizes fine as plain words, only failing
  # when actually executed), '-v "arr[key]"' fails bash's OWN '[[ ]]' parser
  # at *parse time* -- confirmed empirically that even wrapping it in
  # 'if is_zsh; then ... fi', or moving it into a separate function that is
  # never called, does not help: bash must still tokenize a function's body
  # to find its closing brace when *defining* it, so a parse-time error
  # inside an unreached branch still breaks sourcing the whole file. See
  # shell-scripting.md's 'is_zsh guards are for parse-time zsh-only syntax
  # only' section for the general rule this is an instance of.
  if is_zsh; then
    if [[ -z "${_INDENT_CACHE[${depth}]:-}" ]]; then
      # Outermost script (depth 1) has 0 indentation, depth 2 has 2 spaces, etc.
      _INDENT_CACHE[${depth}]="$(printf '%*s' $(((depth - 1) * 2)) '')"
    fi
    printf '%s' "${_INDENT_CACHE[${depth}]}"
  else
    printf '%*s' $(((depth - 1) * 2)) ''
  fi
}

success() {
  # Suppressed when running inside a direnv subshell (see _should_suppress_log).
  # Use error for messages that must always be visible regardless of context.
  if _should_suppress_log; then return 0; fi
  local msg="${1//${HOME}/~}"
  echo "$(_log_indent)✅ $(green '**SUCCESS**') ${msg}"
}

info() {
  # Suppressed when running inside a direnv subshell (see _should_suppress_log).
  # Use error for messages that must always be visible regardless of context.
  if _should_suppress_log; then return 0; fi
  local msg="${1//${HOME}/~}"
  echo "$(_log_indent)ℹ️ $(cyan '**INFO**') ${msg}"
}

warn() {
  # Suppressed when running inside a direnv subshell (see _should_suppress_log).
  # Use error for messages that must always be visible regardless of context.
  if _should_suppress_log; then return 0; fi
  local msg="${1//${HOME}/~}"
  echo "$(_log_indent)⚠️ $(light_red '**WARN**') ${msg}"
}

user_action() {
  # Prints a message prompting the user to perform a manual step (e.g. restart
  # an app, run a command, open a URL). Distinct from warn (which signals an
  # unexpected problem) and info (which is purely informational). Suppressed
  # in direnv subshells -- direnv runs headlessly and cannot act on prompts.
  if _should_suppress_log; then return 0; fi
  local msg="${1//${HOME}/~}"
  echo "$(_log_indent)➡️ $(yellow '**ACTION**') ${msg}"
}

debug() {
  # Hidden by default; only visible when DEBUG=true is set in the environment.
  # Also suppressed when running inside a direnv subshell (see _should_suppress_log).
  # Use error for messages that must always be visible regardless of context.
  if [[ -z "${DEBUG:-}" ]]; then return 0; fi
  if _should_suppress_log; then return 0; fi
  local msg="${1//${HOME}/~}"
  echo "$(_log_indent)⚙️ $(light_purple '**DEBUG**') ${msg}"
}

error() {
  # Inline substitution rather than a color function: the message body is output
  # as plain text (no color wrapper) and also passed to _dotfiles_notify, which receives
  # a raw string -- ANSI codes would appear as literal escape characters there.
  local _msg="${1//${HOME}/~}"
  echo "$(_log_indent)❌ $(red '**ERROR**') ${_msg} 🤓"
  _dotfiles_notify "${_msg} 🤓" "❌ Error" || true
  return 1
}

# --------------------------------------------------------------------------
# 1c. Terminal and section header constants
# --------------------------------------------------------------------------

# Terminal width fallback when COLUMNS is unavailable (cron, non-TTY contexts).
# Standard assumption: 80-column terminal is the baseline for readability.
# Minimum padding of 10 characters prevents headers from touching screen edges.
# Exported so subprocesses (run-all.rb -> git commands -> section_header) can access them.
export _FALLBACK_TERMINAL_WIDTH=80
export _HEADER_MIN_PADDING=10

# Section header styles by level. Each level has a distinct visual style
# (character, glyph, color) to create a clear visual hierarchy.
# Format: "char|glyph|color_function"
# Associative array is a zsh/bash-4+ feature; guard for bash compatibility
# (direnv sources this file in a bash subshell) -- mirrors _INDENT_CACHE above.
# section_header falls back to a plain, unstyled header under bash.
if is_zsh; then
  typeset -A _SECTION_STYLES
  _SECTION_STYLES[0]="=|⏳|light_blue"   # Level 0: Top-level sections (depth 1)
  _SECTION_STYLES[1]="-|🔷|cyan"         # Level 1: Sub-sections (depth 2)
  _SECTION_STYLES[2]="·|▸|yellow"        # Level 2: Collection items (depth 3)
  _SECTION_STYLES[3]="·|▫|purple"        # Level 3: Operations within items (depth 4)
  _SECTION_STYLES[4]="·|▪|dark_gray"     # Level 4: Deep nesting (depth 5+)
fi

# --------------------------------------------------------------------------
# 1c-1. iTerm2 shell integration marks
# --------------------------------------------------------------------------

# Outputs iTerm2 shell integration mark A (prompt start).
# Called by starship custom.iterm2_mark segment.
# Returns: escape sequence \033]133;A\007
iterm2_mark_prompt_start() {
  printf '\033]133;A\007'
}

# Outputs iTerm2 shell integration mark B (prompt end).
# Called by starship custom.iterm2_end segment.
# Returns: escape sequence \033]133;B\007
iterm2_mark_prompt_end() {
  printf '\033]133;B\007'
}

# Outputs iTerm2 shell integration mark C (command start).
# Called by preexec hook in .zshrc (before command execution).
# Returns: escape sequence \033]133;C\007
iterm2_mark_command_start() {
  printf '\033]133;C\007'
}

# Outputs iTerm2 shell integration mark D (command end with exit code).
# Called by precmd hook in .zshrc (after command execution).
# Arguments: $1 = exit code of last command
# Returns: escape sequence \033]133;D;$?\007
iterm2_mark_command_end() {
  printf '\033]133;D;%s\007' "${1:-0}"
}

# --------------------------------------------------------------------------
# 1d. Section header helpers
# --------------------------------------------------------------------------

# Prints <char> repeated <length> times to stdout. Used by section header
# helpers to generate padding lines. Defaults to '-' for the char and a
# quarter of the terminal width for the length.
# Internal helper shared by section_header and print_script_summary.
# Repeats a character N times using printf.
# Usage: _repeat_char <char> <length>
_repeat_char() {
  local char="${1:-}"
  local length="${2:-0}"
  printf "${char}%.0s" {1..${length}}
}

# Strips ANSI escape codes from a string to get visual length.
# Uses zsh parameter expansion to avoid subshell fork (critical for ERR trap contexts).
# Falls back to sed in bash (direnv sources this file in bash subshell).
# Returns the stripped string via stdout.
# Usage: result="$(_strip_ansi "${colored_string}")"
_strip_ansi() {
  local _stripped="${1:-}"
  if [[ -n "${ZSH_VERSION-}" ]]; then
    # Zsh: Use parameter expansion with extendedglob to avoid subshell fork.
    # (S) = shortest match; ## = one-or-more (requires extendedglob); replaces all globally.
    # Pattern: ESC + '[' + zero-or-more digits/semicolons + final letter (e.g. \e[0;31m).
    # local_options scopes extendedglob to this function only.
    setopt local_options extendedglob
    local _esc=$'\e'
    _stripped="${(S)_stripped//${_esc}\[[0-9;]##[a-zA-Z]/}"
  else
    # Bash: Use sed (forks subprocess, but bash context is rare - only direnv .envrc).
    # Pattern matches ESC + '[' + any chars + letter (ANSI escape sequences).
    _stripped="$(echo "${_stripped}" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g')"
  fi
  echo "${_stripped}"
}

# Prints a section header with visual hierarchy based on current script depth.
# Prints a section header with visual hierarchy based on current script depth.
# Level is automatically derived from script depth (depth 1 = level 0, depth 2 = level 1, etc.).
#
# Visual styles:
# - Level 0 (depth 1): = ⏳ light_blue (top-level sections)
# - Level 1 (depth 2): - 🔷 cyan (sub-sections)
# - Level 2+ (depth 3+): · ▸ yellow (nested sections)
#
# Usage: section_header "Header Text"
section_header() {
  local header="${1:-}"

  # Automatically derive level from script depth: depth 1 -> level 0, depth 2 -> level 1, etc.
  local level=$((${_DOTFILES_SCRIPT_DEPTH:-1} - 1))
  [[ ${level} -lt 0 ]] && level=0

  # Auto-set _current_section unless manually set via direct assignment (which also
  # sets _current_section_manual=1). This provides progressively more specific context
  # as execution descends through nested operations. Manual assignments prevent auto-updates,
  # allowing concise error attribution while displaying descriptive headers.
  # Uses dynamic scoping: both _current_section and _current_section_manual must be
  # declared local in the calling script's main().
  if [[ "${_current_section_manual:-0}" != "1" ]]; then
    # Strip ANSI codes before setting (header may contain color codes from caller)
    _current_section="$(_strip_ansi "${header}")"
  fi

  # _SECTION_STYLES is a zsh-only associative array (see its declaration above) --
  # bash falls back to a plain, unstyled header (direnv/.envrc context only;
  # visual styling is an interactive-shell nicety, not load-bearing behavior).
  if ! is_zsh; then
    echo "===== ${header} ====="
    return 0
  fi

  # Get style for this level (fallback to highest defined level if out of bounds)
  # Cap level at max defined level to prevent undefined key access under set -u
  # Use (( ... )) for array length - safer under set -u than ${#...[@]}
  local max_level=0
  (( max_level = ${#_SECTION_STYLES[@]} - 1 )) 2>/dev/null || max_level=4
  [[ ${max_level} -lt 0 ]] && max_level=0  # Safety: ensure non-negative
  [[ ${level} -gt ${max_level} ]] && level=${max_level}

  # If array key doesn't exist, fall back to simple output without style
  # Use ${+...} to check if parameter is set (works under set -u). This is a
  # zsh-only parameter expansion flag -- safe here since the ! is_zsh check
  # above already returned for bash.
  if (( ! ${+_SECTION_STYLES[${level}]} )); then
    echo "===== ${header} ====="
    return 0
  fi

  local style="${_SECTION_STYLES[${level}]}"
  local char="${style%%|*}"            # Extract char (everything before first |)
  local rest="${style#*|}"             # Remove char and first |
  local glyph="${rest%%|*}"            # Extract glyph (everything before next |)
  local color_fn="${rest#*|}"          # Extract color function (everything after last |)

  # Inline substitution: the header is plain text between colored padding segments
  header="${header//${HOME}/~}"

  # Section headers use only base depth indentation (no subordinate levels).
  # The level variable selects the visual style (char/glyph/color), not indentation.
  local indent="$(_log_indent)"
  local indent_len=${#indent}

  # ${COLUMNS} is a zsh special variable -- no tput subprocess fork needed.
  # Fallback to _FALLBACK_TERMINAL_WIDTH when COLUMNS is 0 (e.g. cron -- no terminal attached).
  local viewport_length=${COLUMNS:-${_FALLBACK_TERMINAL_WIDTH}}

  # Strip ANSI codes to get visual length (header may contain color codes from caller)
  local header_visual="$(_strip_ansi "${header}")"
  local header_length=${#header_visual}

  # Left-aligned headers: text starts at fixed position for vertical scanability
  # Left padding: 5 chars min (prevents touching left edge)
  # Right padding: fills remaining width minus 10 chars (prevents touching right edge)
  local left_padding_len=$((5 - indent_len))
  [[ ${left_padding_len} -lt 1 ]] && left_padding_len=1
  local right_padding_len=$((viewport_length - indent_len - left_padding_len - 3 - header_length - _HEADER_MIN_PADDING))
  [[ ${right_padding_len} -lt 1 ]] && right_padding_len=1

  local left_padding right_padding
  left_padding="$(_repeat_char "${char}" "${left_padding_len}")"
  right_padding="$(_repeat_char "${char}" "${right_padding_len}")"
  echo "${indent}$(${color_fn} "${left_padding}") ${glyph} ${header} $(${color_fn} "${right_padding}")"
}

# Formats a duration given in seconds into a human-readable string "HH:MM:SS".
# Writes the result directly into the caller-supplied variable name (no subshell).
# Usage: format_duration <seconds> <varname>
# Example: format_duration 3725 my_var  ->  my_var="01h:02m:05s"
format_duration() {
  local _fd_seconds="${1:-}" _fd_varname="${2:-}"
  printf -v "${_fd_varname}" '%02dh:%02dm:%02ds' \
    $((_fd_seconds / 3600)) \
    $(((_fd_seconds % 3600) / 60)) \
    $((_fd_seconds % 60))
}

# Writes the current epoch seconds into the caller-supplied variable. Zsh:
# reads $EPOCHSECONDS directly (zero-cost, from zsh/datetime, loaded near the
# top of this file) -- critical for the interactive-shell hot path. Bash forks
# 'date +%s' instead (zsh/datetime has no bash equivalent) -- acceptable since
# bash sources this file rarely (direnv .envrc only).
# Usage: _epoch_seconds <varname>
_epoch_seconds() {
  if is_zsh; then
    eval "${1}=\${EPOCHSECONDS}"
  else
    eval "${1}=\$(date +%s)"
  fi
}

# Writes a formatted datetime string for the given epoch seconds into the
# caller-supplied variable. Zsh: 'strftime -s' (zsh/datetime builtin, no fork).
# Bash: BSD 'date -j -f "%s"' (this codebase is macOS-only, so BSD date's
# syntax is safe to assume) -- forks a subprocess, acceptable for the rare
# bash/.envrc context.
# Usage: _strftime <varname> <format> <epoch-seconds>
_strftime() {
  if is_zsh; then
    strftime -s "${1}" "${2}" "${3}"
  else
    eval "${1}=\$(/bin/date -j -f '%s' '${3}' '+${2}')"
  fi
}

# Writes the current datetime as "YYYY-MM-DD HH:MM:SS" into the caller-supplied variable.
# Usage: current_timestamp <varname>
current_timestamp() {
  local _epoch
  _epoch_seconds _epoch
  _strftime "${1:-}" '%Y-%m-%d %H:%M:%S' "${_epoch}"
}

# Writes the current datetime as "YYYY-MM-DD-HH-MM" into the caller-supplied variable.
# Suitable for use in filenames and hostnames (no colons or spaces).
# Usage: current_timestamp_for_filename <varname>
current_timestamp_for_filename() {
  local _epoch
  _epoch_seconds _epoch
  _strftime "${1:-}" '%Y-%m-%d-%H-%M' "${_epoch}"
}

# Prints a timestamped "Script started at" banner. Call at the top of main() and
# capture ${EPOCHSECONDS} before calling to pass to print_script_summary later.
# Only prints when this is the outermost script -- nested subprocess scripts
# stay silent so the outer script's banner is unambiguous in cron output.
print_script_start() {
  # is_outermost_script || return 0: safe under set -e -- both branches resolve
  # to exit 0 (|| only fires when is_outermost_script returns 1, and return 0
  # exits with 0). Avoids the && pattern where the false branch returns 1.
  is_outermost_script || return 0
  # Suppressed when running inside a direnv subshell (same as info/success).
  _should_suppress_log && return 0
  local start_time_human
  current_timestamp start_time_human
  echo "$(cyan "${_SCRIPT_NAME:-}") $(purple '==>') $(yellow 'Script started at:') $(light_blue "${start_time_human}")"
}

# Prints a "Script finished at / Total duration" banner.
# Usage: print_script_duration <start_epoch_seconds>
# If start_epoch_seconds is empty or omitted, returns silently -- safe to call
# unconditionally when the start time may not have been captured.
# Only prints when this is the outermost script -- see print_script_start.
print_script_duration() {
  is_outermost_script || return 0
  # Suppressed when running inside a direnv subshell (same as info/success).
  _should_suppress_log && return 0
  local start_time_seconds="${1:-}"
  if is_zero_string "${start_time_seconds}"; then return 0; fi
  local end_time_human
  current_timestamp end_time_human
  local end_time_seconds
  _epoch_seconds end_time_seconds
  local duration=$((end_time_seconds - start_time_seconds))

  local duration_human
  format_duration "${duration}" duration_human

  echo "$(cyan "${_SCRIPT_NAME:-}") $(purple '==>') $(yellow 'Script finished at:') $(light_blue "${end_time_human}") ($(yellow 'Total duration:') $(light_blue "${duration_human}") $(yellow 'seconds'))."
}

# --------------------------------------------------------------------------
# 1c. Global state variables
#
# Variables that form the shared-state backbone of .shellrc and the scripts
# that source it. Documented here in one place to make the relationships
# between them clear.
#
# CONVENTION -- three tiers, same _ prefix for tiers 2 and 3:
#
#   _DOTFILES_* ALL_CAPS  (exported env var)
#     Internal infrastructure. Inherited by subprocesses via export.
#     Examples: _DOTFILES_SCRIPT_DEPTH, _DOTFILES_CRON_BACKUP_FILE.
#
#   _lowercase  typeset -a at file scope  (non-exported global)
#     Process-wide arrays declared once in this file. Shared by all
#     functions in the same process without exporting.
#     Examples: _script_start_times, _step_start_times.
#
#   _lowercase  local -a / local in main()  (dynamically-scoped local)
#     Declared in each script's main(). Zsh's dynamic scoping makes them
#     readable by callees without being passed as arguments.
#     Examples: _step_warnings, _step_errors, _current_section.
#
# The declaration context (typeset -a at file scope vs. local inside main())
# and surrounding comments distinguish tiers 2 and 3 -- no additional naming
# difference is needed.
#
# --- Collection-pattern locals (tier 3) ---
#
#   _step_warnings          (local -a in each script's main())
#     Array of non-critical recoverable issue strings. Populated by
#     _record_warning(). Read and printed by print_script_summary().
#
#   _step_errors            (local -a in each script's main())
#     Array of significant non-fatal failure strings. Populated by
#     _record_error(). Read and printed by print_script_summary().
#
#   _current_section        (local in each script's main())
#     String tracking which named section/step is currently executing.
#     Set directly (no 'local') inside helpers like _perform_update so
#     the assignment writes into main()'s local via dynamic scoping.
#     Included in every _record_warning/_record_error message as context.
#
# --- Depth counter (tier 1) ---
#
#   _DOTFILES_SCRIPT_DEPTH  (exported env var)
#     Integer counter incremented by each main() that uses the collection
#     pattern. Inherited by subprocess scripts via export. Since subprocess
#     env changes do not propagate back to the parent, the parent's depth
#     is unaffected by any inner script's execution.
#     print_script_summary() uses this to suppress output when depth > 1,
#     ensuring only the outermost script's summary is printed.
#
# --- Step-timing globals (tier 2) ---
#
#   _script_start_times     (typeset -a, non-exported global)
#     Stack of epoch-second timestamps for script-level start times.
#     Used by step_end() to compute total-elapsed. Must be populated by
#     scripts that use step_start/step_end (fresh-install, software-updates-
#     cron). Scripts that only call print_script_summary() without
#     step_start/step_end do not need it.
#
#   _step_start_times       (typeset -a, non-exported global)
#     Stack of epoch-second timestamps for individual step start times.
#     Pushed by step_start(), popped by step_end(). Supports nested steps.
#
# --- Cron infrastructure (tier 1) ---
#
#   _DOTFILES_CRON_BACKUP_FILE  (exported env var)
#     Path to the temporary crontab backup file. Written by suspend_cron()
#     and fresh-install-of-osx.sh before cron is removed. Read by
#     resume_cron() and EXIT/ERR traps to restore the crontab on exit or
#     failure.
# --------------------------------------------------------------------------

# Dynamically-scoped locals (_step_warnings, _step_errors, _current_section) are declared
# with 'local' inside each script's main() -- no top-level initialisation needed here.

# Non-exported globals: step-timing stacks used by step_start/step_end.
# Two consumers, two mechanisms -- intentionally separate:
#
#   print_script_summary [start_time]
#     Takes its start time as an optional argument (a local variable captured
#     at the top of main()). When non-empty, calls print_script_duration
#     internally. This keeps it self-contained and usable by scripts that
#     never call step_start/step_end (e.g. run-all.rb,
#     cleanup-browser-profiles.rb) -- those scripts do NOT push to
#     _script_start_times and have no need to.
#
#   step_end
#     Needs a "total elapsed since script start" value independently of
#     whatever argument was passed to print_script_summary.  It reads
#     _script_start_times[-1] for this.  Scripts that call step_start/step_end
#     (fresh-install-of-osx.sh, software-updates-cron.sh) MUST push their
#     start epoch onto _script_start_times so step_end's total-elapsed column
#     is correct.
#
# Consequence: if step_start/step_end are ever added to a script that
# only calls print_script_summary (run-all.rb, cleanup-browser-profiles.rb),
# that script must also push its start epoch onto _script_start_times,
# otherwise step_end will fall back to the current time and report 0s elapsed.
typeset -a _script_start_times=()
typeset -a _step_start_times=()

# Exported infrastructure: well-known path for suspend_cron/resume_cron.
# Exported so subshells and ERR/EXIT trap handlers share the same path even
# when they run before .aliases is sourced.
export _DOTFILES_CRON_BACKUP_FILE="${TMPDIR:-/tmp}/crontab_backup"

# --------------------------------------------------------------------------
# 1d. Step timing helpers
# Used by fresh-install-of-osx.sh and software-updates-cron.sh for per-step
# progress reporting. See print_script_start/duration (section 1b) for
# overall script timing, which is independent of this stack-based mechanism.
# --------------------------------------------------------------------------

# Initialise the script-level clock.  Pushes if the stack is empty so the same
# process can define a later epoch without clobbering the original.  Safe to
# call multiple times.
step_timing_init() {
  if is_empty_array _script_start_times; then
    local _now
    _epoch_seconds _now
    _script_start_times+=("${_now}")
  fi
}

# Record the start of a step.  Should be called just before section_header.
step_start() {
  step_timing_init
  local _now
  _epoch_seconds _now
  _step_start_times+=("${_now}")
}

# Print how long the most recent step took, plus total elapsed since init.
step_end() {
  local now delta_step delta_total
  _epoch_seconds now

  # Pop the most recent step start time from the stack.
  # If the step stack is empty (e.g. step_end called without a matching
  # step_start after an error), fall back to the current epoch's start time
  # from the script timings stack so the duration stays meaningful.
  local step_start_time
  if is_empty_array _step_start_times; then
    if is_non_empty_array _script_start_times; then
      step_start_time="$(_array_last _script_start_times)"
      warn "step_end called without matching step_start; using current epoch start time as fallback"
    else
      step_start_time="${now}"
      warn "step_end called without any timing stack initialised; using current time as fallback"
    fi
  else
    step_start_time="$(_array_last _step_start_times)"
    _array_pop_last _step_start_times
  fi

  delta_step=$((now - step_start_time))
  local step_human
  format_duration "${delta_step}" step_human

  # Use the most recently pushed script-start epoch for total elapsed.
  local script_start_time
  if is_non_empty_array _script_start_times; then
    script_start_time="$(_array_last _script_start_times)"
  else
    script_start_time="${now}"
    warn "step_end: _script_start_times is empty; total elapsed will be 0"
  fi
  delta_total=$((now - script_start_time))
  local total_human
  format_duration "${delta_total}" total_human

  echo "$(purple "$(_log_indent)⏱") $(yellow 'step:') $(light_blue "${step_human}") $(yellow '| elapsed:') $(light_blue "${total_human}")"
}

# Append a non-critical issue to _step_warnings (declared local in the calling script's main).
# Also emits an inline warn so the issue is visible in the log at the point it occurs.
# Relies on zsh dynamic scoping: the caller's main() must declare:
#   local _current_section='(init)'
#   local -a _step_warnings=()
# Each entry is prefixed with [_SCRIPT_NAME][_current_section] for traceability in nested calls.
_record_warning() {
  local msg="${1:-unknown warning}"
  _step_warnings+=("[${_SCRIPT_NAME:-unknown}][${_current_section:-unknown}] ${msg}")
  warn "${msg}"
}

# Append a significant non-fatal failure to _step_errors (declared local in the calling script's main).
# Also emits an inline warn so the failure is visible in the log at the point it occurs.
# Relies on zsh dynamic scoping: the caller's main() must declare:
#   local _current_section='(init)'
#   local -a _step_errors=()
# Each entry is prefixed with [_SCRIPT_NAME][_current_section] for traceability in nested calls.
_record_error() {
  local msg="${1:-unknown error}"
  _step_errors+=("[${_SCRIPT_NAME:-unknown}][${_current_section:-unknown}] ${msg}")
  warn "${msg}"
}

# Returns true if _step_errors array exists and is non-empty.
# Combines existence check (( ${+_step_errors} )) with is_non_empty_array.
# Relies on zsh dynamic scoping: _step_errors must be declared in the calling scope.
#
# Usage:
#   if _has_step_errors; then
#     echo "Found ${#_step_errors[@]} error(s)"
#   fi
_has_step_errors() {
  if is_zsh && ((${+_step_errors})); then
    is_non_empty_array _step_errors
  else
    return 1
  fi
}

# Returns true if _step_warnings array exists and is non-empty.
# Combines existence check (( ${+_step_warnings} )) with is_non_empty_array.
# Relies on zsh dynamic scoping: _step_warnings must be declared in the calling scope.
#
# Usage:
#   if _has_step_warnings; then
#     echo "Found ${#_step_warnings[@]} warning(s)"
#   fi
_has_step_warnings() {
  if is_zsh && ((${+_step_warnings})); then
    is_non_empty_array _step_warnings
  else
    return 1
  fi
}

# Build formatted notification parts from _step_errors and _step_warnings arrays.
# Populates the named array variable with strings formatted as "N error(s)" or
# "N error(s): details", depending on the format argument.
# Relies on zsh dynamic scoping: _step_errors and _step_warnings must be declared
# in the calling scope (typically in main()).
#
# Arguments:
#   $1 - name of array variable to populate (passed by name, not value)
#   $2 - format: 'short' (counts only) or 'long' (counts + details) [default: long]
#
# Usage:
#   local -a notification_parts
#   _build_notification_parts notification_parts 'long'
#   if is_non_empty_array notification_parts; then
#     local body="${(j: | :)notification_parts}"
#     _dotfiles_notify "Message: ${body}" "Title"
#   fi
#
# POSIX compliance note: Uses eval to populate the target array by name. The
# array values are double-quoted during eval to prevent word splitting. The
# function assumes zsh; POSIX shells lack associative arrays and the (j::)
# join operator, so full POSIX compliance is not achievable. The parameter
# validation uses ${1:?} which is POSIX-compliant. Uses is_zsh utility to
# guard zsh-only syntax.
_build_notification_parts() {
  local _bnp_array_name="${1:?_build_notification_parts: missing array name argument}"
  local _bnp_format="${2:-long}"

  # Clear the target array first (zsh syntax: arrayname=())
  eval "${_bnp_array_name}=()"

  # Build errors part
  if _has_step_errors; then
    if [[ "${_bnp_format}" == 'short' ]]; then
      # Short format: just the count
      eval "${_bnp_array_name}+=(\"${#_step_errors[@]} error(s)\")"
    else
      # Long format: count + details joined with '; '
      # Use zsh array join: ${(j:; :)array}
      local _bnp_errors_summary
      _bnp_errors_summary="${(j:; :)_step_errors}"
      eval "${_bnp_array_name}+=(\"${#_step_errors[@]} error(s): ${_bnp_errors_summary}\")"
    fi
  fi

  # Build warnings part
  if _has_step_warnings; then
    if [[ "${_bnp_format}" == 'short' ]]; then
      # Short format: just the count
      eval "${_bnp_array_name}+=(\"${#_step_warnings[@]} warning(s)\")"
    else
      # Long format: count + details joined with '; '
      local _bnp_warnings_summary
      _bnp_warnings_summary="${(j:; :)_step_warnings}"
      eval "${_bnp_array_name}+=(\"${#_step_warnings[@]} warning(s): ${_bnp_warnings_summary}\")"
    fi
  fi
}

# Print a grouped summary of all warnings and errors collected via _record_warning/_record_error.
# Reads _step_warnings and _step_errors from the caller's scope via zsh dynamic scoping.
# Must be called after shellrc is sourced (uses section_header and warn).
#
# Usage: print_script_summary [start_epoch_seconds [message]]
#
# Accepts an optional start time (epoch seconds from ${EPOCHSECONDS}, captured
# before print_script_start). When provided, calls print_script_duration
# internally -- no separate call needed. Omit when no start time is available
# (e.g. early-exit paths before the start epoch was captured).
# Accepts an optional info message as $2. When provided, it is printed via
# info before the warnings/errors list -- use this instead of a bare info/success
# call immediately before print_script_summary. Guarded with ${2:-} so omitting
# it is safe under set -u.
# Only prints when this is the outermost script in a nested call chain.
# _SCRIPT_NAME is read directly via zsh dynamic scoping -- no argument needed.
print_script_summary() {
  # is_outermost_script || return 0: safe under set -e -- see print_script_start.
  is_outermost_script || return 0
  local _pss_start_time="${1:-}"
  local _pss_msg="${2:-}"
  local _pss_title="${_SCRIPT_NAME:-}"

  local viewport_length=${COLUMNS:-${_FALLBACK_TERMINAL_WIDTH}}

  # Use full viewport width for summary separator (no text to account for)
  local final_length="${viewport_length}"
  # Print separator line
  local padding
  padding="$(_repeat_char '*' "${final_length}")"
  echo $(dark_gray "${padding}")

  if is_non_zero_string "${_pss_msg}"; then
    if _has_step_warnings || _has_step_errors; then
      info "⚠️ ${_pss_msg}"
    else
      success "✅ ${_pss_msg}"
    fi
  fi
  if _has_step_warnings; then
    # Temporarily decrement depth so both header and warnings print one level less indented
    _decrement_script_depth
    section_header "$(cyan "${_pss_title}") $(yellow "${#_step_warnings[@]} warning(s)")"
    local _psw
    for _psw in "${_step_warnings[@]}"; do
      warn "${_psw}"
    done
    _increment_script_depth
  fi
  if _has_step_errors; then
    # Temporarily decrement depth so both header and errors print one level less indented
    _decrement_script_depth
    section_header "$(cyan "${_pss_title}") $(red "${#_step_errors[@]} error(s) -- manual attention needed")"
    local _pse
    for _pse in "${_step_errors[@]}"; do
      warn "${_pse}"
    done
    _increment_script_depth
  fi
  # Send exactly one notification when there are issues to report, gated solely
  # on whether errors/warnings were collected -- independent of the title source.
  # Success notifications are intentionally omitted -- the user can see success in
  # the terminal. Notifications are reserved for failures that warrant attention,
  # especially in headless/cron contexts. Scripts with custom success notifications
  # (e.g. fresh-install, software-updates-cron) handle them outside this function.
  local -a _pss_parts=()
  _build_notification_parts _pss_parts 'short'
  if is_non_empty_array _pss_parts; then
    _dotfiles_notify "${_pss_title}: completed with ${(j: and :)_pss_parts}." "⚠️ ${_pss_title}" || true
  fi
  if is_non_zero_string "${_pss_start_time}"; then print_script_duration "${_pss_start_time}"; fi
}

# --------------------------------------------------------------------------
# 1e. Filesystem & OS predicates
# --------------------------------------------------------------------------

# Returns true if $1 is a non-empty path pointing to an executable file or command.
is_executable() {
  if is_non_zero_string "${1:-}" && [[ -x "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if $1 is a non-empty path pointing to a regular file.
is_file() {
  if is_non_zero_string "${1:-}" && [[ -f "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Resolves $2 to its canonical absolute path (following symlinks), writing the
# result into the caller-supplied variable named $1. Zsh: '${path:A}' (zero-
# fork parameter expansion). Bash: a small pure-shell symlink-resolution loop
# plus 'cd ... && pwd -P' for final directory canonicalization -- macOS ships
# neither GNU 'readlink -f' nor 'realpath' by default, so this avoids both.
#
# Note: bash's ${var:A} is NOT a parse or runtime error -- it silently does
# the WRONG thing. Bash interprets ':A' as substring-expansion offset
# arithmetic (${var:offset}); an undefined arithmetic identifier like 'A'
# evaluates to 0, so ${var:A} == ${var:0} == the original string, unresolved.
# Confirmed empirically: this returns a plausible-looking but incorrect result
# rather than failing loudly, making it easy to miss without a dedicated test.
#
# Usage: _resolve_absolute_path <varname> <path>
_resolve_absolute_path() {
  local _varname="${1:-}"
  local p="${2:-}"
  if is_zsh; then
    eval "${_varname}=\${p:A}"
  else
    local link
    while [[ -L "${p}" ]]; do
      link="$(readlink "${p}")"
      if [[ "${link}" == /* ]]; then
        p="${link}"
      else
        # Bash-compatible parent-dir extraction (no dirname fork) -- this file must
        # remain bash-parseable since direnv sources it in a bash subshell.
        p="${p%/*}/${link}"
      fi
    done
    local dir base
    dir="$(cd "${p%/*}" 2>/dev/null && pwd -P)"
    base="${p##*/}"
    if [[ -n "${dir}" ]]; then
      eval "${_varname}=\"\${dir}/\${base}\""
    else
      eval "${_varname}=\"\${p}\""
    fi
  fi
}

# Returns true if target file ($1) is missing or older than source file ($2).
# Resolves symlinks before comparison to ensure edits/upgrades to symlink targets
# are detected (e.g., Homebrew binaries, dotfiles symlinked from the repo).
# Uses the shell's built-in -nt (newer-than) test which compares modification times.
# Common pattern: if is_file_older_than "$cache" "$source"; then regenerate_cache; fi
#
# Arguments:
#   $1 - target file path (typically a cache file)
#   $2 - source file path (typically a binary or config file)
#
# Returns:
#   0 (true) if target is missing or source is newer (regeneration needed)
#   1 (false) if target exists and is newer than or same age as source (cache valid)
#
# Examples:
#   if is_file_older_than "$cache" "$binary"; then "$binary" --generate-cache; fi
#   if is_file_older_than "${git_version_cache}" "${git_bin}"; then cache_git_version; fi
is_file_older_than() {
  # Return true (needs regeneration) if either argument is missing/empty
  if [[ -z "${1:-}" || -z "${2:-}" ]]; then return 0; fi
  local target source
  _resolve_absolute_path target "${1}"
  _resolve_absolute_path source "${2}"
  if ! is_file "${target}" || [[ "${source}" -nt "${target}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if target epoch time is older than source epoch time.
# Used for comparing timestamps when -nt file comparison isn't applicable
# (e.g., comparing file mtime against process start time from ps output).
# Matches is_file_older_than naming pattern for consistency.
#
# Arguments:
#   $1 - target epoch (what you're checking, e.g., daemon start time)
#   $2 - source epoch (what you're comparing against, e.g., config file mtime)
#
# Returns:
#   0 (true) if target is older than source (target < source)
#   1 (false) if target is newer or equal, or if either argument is empty
#
# Example:
#   if is_epoch_older_than "${daemon_epoch}" "${config_epoch}"; then
#     restart_daemon  # daemon started before config was modified
#   fi
is_epoch_older_than() {
  [[ -n "${1:-}" && -n "${2:-}" ]] && [[ ${1} -lt ${2} ]]
}

# Returns true if $1 is a non-empty path pointing to a directory (excluding root '/').
is_directory() {
  if is_non_zero_string "${1:-}" && ! is_root_dir "${1}" && [[ -d "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if $1 is the root directory '/'.
# Used to prevent write operations on paths in root directory.
is_root_dir() {
  [[ "${1:-}" == "/" ]]
}

# Returns true if $1 is a regular file with non-zero size.
is_non_empty_file() {
  if is_file "${1:-}" && [[ -s "${1:-}" ]]; then
    return 0
  else
    return 1
  fi
}

is_directory_empty() {
  # $(ls -A) kept intentionally -- the pure-zsh glob alternative (*(ND[1])) cannot
  # be used here because .shellrc is sourced by direnv in bash, and bash has no
  # zsh glob qualifiers.  A ZSH_VERSION branch was considered but rejected: the
  # function is only called a handful of times (e.g. set_ssh_folder_permissions),
  # never on the startup hot path, so the ls fork cost is negligible.
  if is_directory "${1:-}" && [[ -z "$(ls -A "${1:-}")" ]]; then
    return 0
  else
    return 1
  fi
}

# Creates $1 (and any intermediate directories) if it does not already exist.
# Warns and skips silently if $1 is empty or unset.
# Guards with is_directory to avoid forking mkdir when the directory already
# exists -- the common case on every shell startup (e.g. XDG_CACHE_HOME).
ensure_dir_exists() {
  local target_dir="${1:-}"
  if is_zero_string "${target_dir}"; then
    warn "Skipping creation of the directory since '$(cyan "${target_dir}")' is not defined"
    return 1
  fi
  # Prevent operations on paths in root directory
  # Use ${var%/*} instead of ${var:h} for bash compatibility (direnv sources this in bash)
  if is_root_dir "${target_dir%/*}"; then
    error "Refusing to create directory in root: '$(cyan "${target_dir}")'"
  fi
  if ! is_directory "${target_dir}"; then
    mkdir -pv "${target_dir}"
  fi
}

# Ruby load path for shared utilities -- add both dotfiles and personal bin to RUBYLIB
# so 'ruby -e' one-liners in shell functions (like resume_cron, with_cron_suspended, etc.)
# can use 'require' to load utility modules. Ruby scripts that run as standalone programs
# (like install-dotfiles.rb) use 'require_relative' and do not need RUBYLIB.
#
# IMPORTANT: Must stay in .shellrc (not moved to .aliases) for the fresh-install error
# handling window. During fresh-install, .shellrc is sourced twice: first before dotfiles
# are cloned (RUBYLIB empty but resume_cron defined), then re-sourced after the clone
# (RUBYLIB now set). Between the re-source and when .aliases is loaded, errors can occur
# and resume_cron must work. Moving to .aliases would break error handling during this
# critical window between when .shellrc is re-sourced and when .aliases is finally loaded.
#
# Only add directories that exist.
# Guarded by is_zsh: the array operations are zsh-only and when direnv sources this
# file in bash, this block must be skipped.

# Create RUBYLIB<->rubylib tie at top level so it's available before any function calls.
# Safe to call multiple times (idempotent). Silently skips in bash (is_zsh guard below).
if is_zsh; then
  typeset -gT RUBYLIB rubylib ':' 2>/dev/null || true
fi

# Sets up RUBYLIB paths for Ruby to find utility modules.
# Adds scripts/utilities/ and bin directories to Ruby's load path.
# Deduplicates and exports RUBYLIB. Safe to call multiple times (idempotent).
#
# Called by:
#   - .zshrc during shell startup (makes RUBYLIB available for all subprocesses)
#   - call_ruby_utility before each ruby -e invocation (ensures paths are set)
#
# Usage:
#   setup_rubylib
setup_rubylib() {
  if is_zsh; then
    # Work directly with the rubylib array (tied to RUBYLIB scalar above).
    # Add paths only if they exist.
    if is_directory "${DOTFILES_DIR}/scripts/utilities"; then
      rubylib+=("${DOTFILES_DIR}/scripts/utilities")
    fi
    if is_directory "${PERSONAL_BIN_DIR}"; then
      rubylib+=("${PERSONAL_BIN_DIR}")
    fi
    # Deduplicate after appending.
    # typeset -gU is idempotent -- safe to call multiple times (e.g., on re-source).
    typeset -gU rubylib 2>/dev/null || true

    # Export RUBYLIB so Ruby can see it. typeset -gT does not export automatically.
    export RUBYLIB
  fi
}

# Invokes a Ruby utility module method with proper environment setup.
# Automatically sets up RUBYLIB and preserves COLUMNS for Ruby scripts that
# need terminal width information.
#
# Arguments:
#   $1 - Ruby code to execute (require + method call)
#
# Usage:
#   call_ruby_utility "require 'git_processor'; GitProcessor.migrate_to_reftable(folder: '${folder}')"
#   call_ruby_utility "require 'macos'; MacOS.kill_login_item_apps"
#
# Example delegation pattern:
#   my_wrapper() {
#     call_ruby_utility "require 'my_module'; MyModule.my_method"
#   }
call_ruby_utility() {
  local ruby_code="${1:?call_ruby_utility: Ruby code required}"

  # Guard: Ruby must be available (vanilla OS before Homebrew installs it)
  if ! command_exists ruby; then
    debug "Ruby not available -- skipping Ruby call"
    return 0
  fi

  # Set up RUBYLIB to include utility modules
  setup_rubylib

  COLUMNS="${COLUMNS}" ruby -e "${ruby_code}"
}

# Returns true if $1 is a non-empty path whose direct child .git directory exists.
# Checks the repo root explicitly -- does not work from nested sub-directories by design.
# Alternative that works from any nested sub-directory:
#   git -C "${1:-}" rev-parse --is-inside-work-tree &>/dev/null
is_git_repo() {
  if is_non_zero_string "${1:-}" && is_directory "${1:-}/.git"; then
    return 0
  else
    return 1
  fi
}

# Recompiles a zsh script file to bytecode (.zwc) if the source is newer than the compiled form.
# Used by .zlogin for bulk recompilation, by .zshrc when regenerating cache files, and by
# load_file_if_exists below (defined here, before its caller, so a top-to-bottom reader
# sees the dependency before its use).
# Resolves symlinks explicitly so the .zwc is written next to the symlink, not the target.
# Handles cleanup of stale .zwc.old files left by failed zrecompile runs.
# Usage: recompile_zsh_script <file-path>
recompile_zsh_script() {
  local file="${1:-}"
  # Return early if no file path provided (defensive under set -u)
  if is_zero_string "${file}"; then
    return 0
  fi
  # Prevent operations on paths in root directory
  # Use ${var%/*} instead of ${var:h} for bash compatibility (direnv sources this in bash)
  if is_root_dir "${file%/*}"; then
    warn "Refusing to recompile file in root directory: '$(cyan "${file}")'"
    return 1
  fi
  # Resolve symlinks explicitly: is_file_older_than handles this internally, but we need
  # the real path here for the is_non_empty_file check and because the .zwc file lives
  # next to the symlink (${file}.zwc), not next to the target file.
  local real
  _resolve_absolute_path real "${file}"
  if is_non_empty_file "${real}" && is_file_older_than "${file}.zwc" "${real}"; then
    debug "recompiling '${file}'"
    # zrecompile is only autoloaded by .zshrc (interactive shells). Any caller
    # that reaches this point without .zshrc having run yet (cron jobs,
    # scripts, load_file_if_exists's safeguard from a non-interactive context)
    # would otherwise call an undefined function, silently swallowed by the
    # '|| true' below -- recompilation would appear to succeed (exit 0) but
    # never actually write a fresh .zwc. autoload -Uz is idempotent and cheap
    # (no fork) -- safe to call unconditionally every time. Guarded on
    # is_zsh since .shellrc must remain bash-parseable for direnv's bash
    # subshell, and autoload is a zsh-only builtin.
    if is_zsh; then
      autoload -Uz zrecompile
    fi
    # Remove any stale .zwc.old left by a previously failed zrecompile run before
    # attempting recompilation. zrecompile writes .zwc files read-only; if zcompile
    # fails mid-write the .zwc.old backup is left behind -- clean it up unconditionally.
    rm -f "${file}.zwc.old" || true
    zrecompile -pq "${file}" &>/dev/null || true
    # Remove .zwc.old again in case this run moved the old file there before failing.
    rm -f "${file}.zwc.old" || true
  fi
}

# Sources $1 if it is a non-empty path pointing to a regular file; warns otherwise.
load_file_if_exists() {
  if is_file "${1:-}"; then
    # Keep the .zwc bytecode cache in sync before sourcing. Cheap (a couple of
    # stat calls via recompile_zsh_script's is_file_older_than check, no fork;
    # measured at ~0.05ms) and only actually recompiles when stale. This is a
    # safeguard for contexts that never go through .zlogin's bulk recompile
    # pass (cron jobs, scripts, direnv's bash subshell -- anything sourcing
    # .shellrc/.aliases/etc directly outside a login shell) -- without it,
    # such contexts would never pick up the compiled-bytecode form, forever.
    recompile_zsh_script "${1:-}"
    # || warn (not a hard failure) catches source failures from external files
    # that may contain standalone && chains or other constructs that return
    # non-zero in normal operation (e.g., completion scripts). Logs a warning
    # but continues.
    source "${1:-}" || warn "Failed to source file: '$(cyan "${1:-}")' - continuing anyway"
  fi
}

# Returns true if $1 names a known command, function, alias, or shell builtin.
command_exists() {
  if (($+commands[${1:-}] || $+functions[${1:-}] || $+aliases[${1:-}] || $+builtins[${1:-}])); then
    return 0
  else
    return 1
  fi
}

# Returns true if the current OS is macOS.
is_macos() {
  # == glob is faster than =~ (no regex engine); valid in both bash [[ ]] and zsh.
  if [[ "${OSTYPE}" == *darwin* ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if the current OS is Linux.
is_linux() {
  # == glob is faster than =~ (no regex engine); valid in both bash [[ ]] and zsh.
  if [[ "${OSTYPE}" == *Linux* ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if FIRST_INSTALL is set to a non-empty value.
# ${FIRST_INSTALL:-} uses the ':-' operator: if FIRST_INSTALL is unset OR empty,
# substitute empty string; if set and non-empty, use its value. Combined with -n,
# this is true only when FIRST_INSTALL holds a real value -- treating unset and
# set-but-empty identically. This is intentional: only a deliberate non-empty
# assignment (e.g. FIRST_INSTALL=true) should activate vanilla-OS behaviour.
# Note: two occurrences in fresh-install-of-osx.sh use the raw form because
# they run before _download_and_source_shellrc has sourced .shellrc.
is_first_install() {
  if [[ -n "${FIRST_INSTALL:-}" ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if the current OS is Windows (MSYS/MinGW environment).
is_windows() {
  # == glob is faster than =~ (no regex engine); consistent with is_macos/is_linux.
  if [[ "${OSTYPE}" == *MINGW* ]]; then
    return 0
  else
    return 1
  fi
}

# Returns true if this is the outermost script in a nested call chain.
# _DOTFILES_SCRIPT_DEPTH is exported and incremented by each main() that uses
# the deferred-collection pattern. Subprocesses inherit the counter but their
# increments do not propagate back to the parent. Defaults to 0 when unset so
# standalone scripts (which never set the counter) are treated as outermost --
# consistent with the ':-0' used in the increment expression in each main().
is_outermost_script() {
  if [[ ${_DOTFILES_SCRIPT_DEPTH:-0} -eq 1 ]]; then
    return 0
  else
    return 1
  fi
}

# Increments _DOTFILES_SCRIPT_DEPTH by 1. Does not guard against overflow since
# depth > 100 would indicate a bug (infinite recursion). Used internally by
# print_script_summary to temporarily adjust depth.
_increment_script_depth() {
  export _DOTFILES_SCRIPT_DEPTH=$((${_DOTFILES_SCRIPT_DEPTH:-0} + 1))
}

# Decrements _DOTFILES_SCRIPT_DEPTH, guarding against underflow. Called from
# EXIT traps in every script that increments the counter. Mirrors
# Logging.decrement_script_depth in logging.rb.
_decrement_script_depth() {
  if [[ ${_DOTFILES_SCRIPT_DEPTH:-0} -gt 0 ]]; then
    export _DOTFILES_SCRIPT_DEPTH=$((_DOTFILES_SCRIPT_DEPTH - 1))
  fi
}

# Returns true if sudo credentials are currently cached (i.e. sudo can run
# without prompting for a password). Use this to guard any function that calls
# sudo and may be invoked from cron or other non-interactive contexts where a
# prompt would hang indefinitely.
has_sudo_credentials() {
  if sudo -n true 2>/dev/null; then
    return 0
  else
    return 1
  fi
}

# --------------------------------------------------------------------------
# 1f. PATH & environment variable manipulation
# --------------------------------------------------------------------------

# Append helpers: each adds $1 to the named variable only if $1 is an
# existing directory. No-op if the directory does not exist. Safe to call
# multiple times -- the underlying path arrays deduplicate in zsh.
#
# Zsh's 'path'/'fpath' are special arrays automatically tied to the $PATH/
# $FPATH scalar strings. Bash has no such tying -- 'path+=...'/'fpath+=...'
# under bash would silently create an unrelated ordinary variable named
# 'path'/'fpath', never touching $PATH/$FPATH at all (confirmed empirically;
# no error, just silently wrong -- the same class of bug as ${var:A} above).
append_to_path_if_dir_exists() {
  if is_non_zero_string "${1:-}" && is_directory "${1:-}"; then
    if is_zsh; then
      path+="${1:-}"
    else
      # Bash: manipulate $PATH directly, with the same dedup guarantee zsh's
      # tied array gives for free.
      case ":${PATH}:" in
        *":${1}:"*) ;; # already present -- no-op
        *) PATH="${PATH}:${1}" ;;
      esac
    fi
  fi
}

# Bash has no FPATH/function-autoloading concept at all (that's a zsh-only
# feature), so this is an intentional no-op under bash, not an oversight.
append_to_fpath_if_dir_exists() {
  if is_non_zero_string "${1:-}" && is_directory "${1:-}" && is_zsh; then
    fpath+="${1:-}"
  fi
}

# --------------------------------------------------------------------------
# 1g. Bootstrap operations
# Called by fresh-install-of-osx.sh and post-brew-install.sh.
# set_ssh_folder_permissions is also called from ~/.envrc directly.
# --------------------------------------------------------------------------

# Asks for the administrator password upfront and keeps it alive until the calling script
# finishes. Uses a background loop that refreshes sudo every 60 seconds.
# Safe to call multiple times -- skips silently if the background loop is already running.
keep_sudo_alive() {
  # Avoid duplicate background loops (e.g. when child scripts also call this)
  if is_non_zero_string "${KEEP_SUDO_ALIVE_PID:-}" && kill -0 "${KEEP_SUDO_ALIVE_PID}" 2>/dev/null; then
    return
  fi
  step_start
  section_header "$(yellow 'Keeping sudo alive till this script has finished')"
  sudo -v
  # || true prevents has_sudo_credentials return code (1 when credentials expire)
  # from triggering ERR trap in scripts that source .shellrc with set -E.
  while true; do has_sudo_credentials || true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
  export KEEP_SUDO_ALIVE_PID=$!
  step_end
}

# Migrates a git repository to reftable format if git 2.45+ is available.
# Thin wrapper that delegates to the git migrate-reftable alias.
# Usage: migrate_git_repo_to_reftable <repo-directory>
# Returns: 0 on success or if already reftable, 1 if git 2.45+ unavailable
# Note: On vanilla macOS with system git < 2.45, this returns 1 (unsupported).
# fresh-install-of-osx.sh calls this again after Homebrew's git is on PATH.
migrate_git_repo_to_reftable() {
  local folder="${1:?migrate_git_repo_to_reftable: folder argument required}"

  git migrate-reftable "${folder}"
}

# Clones a git repo into a temp folder, moves the .git dir into the real target
# location, and does an initial checkout there. Works around git's refusal to
# clone into a non-empty directory (e.g. HOME). If the target is already a git
# repo, runs fetch to pull updates. New clones always use --depth=1 --filter=blob:none
# --single-branch for fast initial clone. All repos (new and existing) are converted
# to full clones asynchronously via background 'git unshallow' job after the main
# operation completes. Always updates submodules afterwards.
# Usage: clone_repo_into <repo-url> <target-folder> [branch]
clone_repo_into() {
  local start_time
  _epoch_seconds start_time  # zsh: $EPOCHSECONDS (no fork); bash: 'date +%s' fork
  local target_folder="${2:-}"
  ensure_dir_exists "${target_folder}"
  if ! is_git_repo "${target_folder}"; then
    # Since git does not allow cloning into a non-empty folder (like the home folder), clone into a temp folder, then copy the .git folder into the real target location, and do a checkout
    local tmp_folder
    tmp_folder="$(mktemp -d)"

    # Set trap to clean up temp folder on exit (normal or error)
    trap "rm -rf '${tmp_folder}'" EXIT INT TERM

    local -a clone_args=('--depth=1' '--filter=blob:none' '--single-branch')
    local target_branch="${3:-}"
    # If a target branch is specified, clone that branch directly to avoid the
    # "branch not found" error when switching after a shallow clone (which only
    # fetches the default branch). Without --branch, git switch would fail.
    if is_non_zero_string "${target_branch}"; then
      clone_args+=('--branch' "${target_branch}")
    fi
    debug "Using shallow blobless single-branch clone (${clone_args[*]}) for fast initial clone"

    # Capture stderr to display on failure
    local stderr_file
    stderr_file="$(mktemp)"
    trap "rm -rf '${tmp_folder}' '${stderr_file}'" EXIT INT TERM

    # -n (--no-checkout): Skip checkout in tmp (only .git needed; we restore in target).
    # SSH: Uses core.sshCommand from ~/.gitconfig (pre-configured) or inherits GIT_SSH_COMMAND
    # from parent environment (FIRST_INSTALL - exported by fresh-install-of-osx.sh, propagates
    # through shell-> Ruby-> shell chain). No inline override needed.
    # Wrapped with 'git with-retry': flaky networks (VPN/MTU black-holes) can cause this
    # clone to stall indefinitely rather than fail fast. Implemented as a git alias (not a
    # shell function) so the retry/timeout/process-tree-kill logic lives in one place and
    # is reusable by any other git alias (e.g. 'unshallow') without sourcing ~/.shellrc.
    # Passes tmp_folder as the progress-path so with-retry only kills on genuine inactivity
    # (no growth in the folder being cloned into) rather than a fixed wall-clock timeout --
    # a large repo that is transferring slowly but steadily is not killed prematurely.
    local clone_timeout_secs=25
    local clone_max_attempts=5
    git with-retry "${clone_timeout_secs}" "${clone_max_attempts}" "${stderr_file}" "${tmp_folder}" \
      git -C "${tmp_folder}" clone -q -n -c init.defaultRefFormat=reftable "${clone_args[@]}" "${1:-}" .
    local clone_status=$?

    if [[ ${clone_status} -ne 0 ]]; then
      local error_msg="Failed to clone '$(cyan "${1:-}")' into '$(cyan "${target_folder}")'"
      local stderr_content
      stderr_content="$(cat "${stderr_file}" 2>/dev/null)"
      if is_non_zero_string "${stderr_content}"; then
        error_msg="${error_msg}"$'\n'"Clone command STDERR:"$'\n'"${stderr_content}"
      fi
      warn "${error_msg}"
      return 1
    fi

    # Remove existing .git directory if present (cleanup from failed previous clone attempt).
    # We're in the "not a git repo" branch (outer if), but .git directory might exist as
    # leftover debris. Check directory existence directly, not is_git_repo (which would
    # return false since we're already in the ! is_git_repo branch).
    if is_directory "${target_folder}/.git"; then
      # Prevent operations on paths in root directory
      # Use ${var%/*} instead of ${var:h} for bash compatibility (direnv sources this in bash)
      if is_root_dir "${target_folder%/*}"; then
        error "Refusing to remove .git directory from path in root: '$(cyan "${target_folder}")'"
      fi
      rm -rf "${target_folder}/.git"
    fi

    mv "${tmp_folder}/.git" "${target_folder}"
    rm -rf "${tmp_folder}" "${stderr_file}"
    trap - EXIT INT TERM  # Clear trap after successful move

    # Populate index from HEAD, then checkout files.
    # For home directory clones: use 'git checkout --force' to overwrite existing files
    # (e.g., ~/.ssh/config might exist as an empty stub on vanilla macOS). For other repos:
    # use 'checkout-index -a' which refuses to overwrite (safer for repos in dev directories).
    git -C "${target_folder}" read-tree HEAD
    if [[ "${target_folder}" == "${HOME}" ]]; then
      # Force overwrite existing files when cloning home repo
      git -C "${target_folder}" checkout --force HEAD 2>/dev/null || true
    else
      # Don't overwrite existing files for non-home repos
      git -C "${target_folder}" checkout-index -a 2>/dev/null || true
    fi

    # Correct HEAD file after reftable clone-via-mv (.git/HEAD retains a '.invalid' placeholder since
    # the move bypasses git's normal post-clone finalisation; shell prompts read .git/HEAD directly)
    local real_ref
    real_ref="$(git -C "${target_folder}" symbolic-ref HEAD 2>/dev/null)"
    if is_non_zero_string "${real_ref}"; then
      echo "ref: ${real_ref}" >"${target_folder}/.git/HEAD"
    fi

    success "Successfully cloned '$(cyan "${1:-}")' into '$(cyan "${target_folder}")'"

    if is_non_zero_string "${target_branch}"; then
      local current_branch
      current_branch="$(git -C "${target_folder}" branch --show-current)"
      if [[ "${current_branch}" != "${target_branch}" ]]; then
        error "Branch mismatch: expected '$(cyan "${target_branch}")' but got '$(cyan "${current_branch}")' - something is wrong. Please correct before retrying!"
        return 1
      fi
    fi
  else
    # is_git_repo = (is_non_zero_string && is_directory .git) -- logical complement of the if above,
    # so this else is exhaustive and the condition check is redundant.
    debug "Repo already exists at '$(yellow "${target_folder}")' -- will unshallow and fetch in background"
  fi

  # Migrate to reftable format BEFORE background unshallow to avoid race conditions.
  # Migrating refs while unshallow is fetching history could cause lock contention or
  # corrupted refs. Migration must complete before any background ref writes begin.
  # Idempotent -- safe to run multiple times (no-op if already reftable). On vanilla
  # macOS with system git < 2.45, this is a silent no-op. fresh-install-of-osx.sh
  # calls this again after Homebrew's git is on PATH to migrate repos that were
  # initially cloned with system git.
  migrate_git_repo_to_reftable "${target_folder}"

  # Unshallow and run repository maintenance for both new clones and existing repos.
  # Converts shallow repos to full clones. If the repo is already a full clone, 'git
  # unshallow' is a no-op. 'unshallow' wraps its own fetch/backfill steps in 'git
  # with-retry' internally (see git/config) so a stalled fetch (flaky network) cannot
  # hang this step forever -- every other caller of 'git unshallow' (e.g. antidote.rb,
  # 'pullsub') gets the same hang protection automatically. 'maintain' (mtime restore +
  # prune/gc/commit-graph) is run sequentially AFTER unshallow completes -- running it
  # concurrently would race both processes against the same .git directory: 'maintain'
  # unconditionally removes index.lock and commit-graph-chain.lock, which could steal a
  # lock 'unshallow' legitimately holds mid-write.
  #
  # On FIRST_INSTALL and non-FIRST_INSTALL callers alike, this runs SYNCHRONOUSLY.
  # Backgrounding this during FIRST_INSTALL bootstrap was considered for wall-clock
  # savings (bootstrap also installs Homebrew/brew bundle in parallel), but rejected:
  # fresh-install-of-osx.sh re-runs 'migrate_git_repo_to_reftable "${DOTFILES_DIR}"'
  # later in its sequence (once Homebrew's newer git is on PATH), which does a
  # destructive 'rm -rf .git/refs/*' on the SAME repo this function may have just
  # spawned a background fetch/gc for -- with no synchronization between the two, a
  # sufficiently large history/backfill could still be running when that later step
  # fires, reintroducing exactly the concurrent-git-operation race this whole retry/
  # maintenance chain is designed to avoid. The one-time wall-clock cost during vanilla
  # OS bootstrap is an acceptable trade for eliminating that race entirely.
  # If all attempts fail, the next clone_repo_into call will retry.
  git -C "${target_folder}" unshallow
  git -C "${target_folder}" maintain
  debug "Completed unshallow + maintain for '$(yellow "${target_folder}")'"

  # Always update submodules after clone or pull -- new commits may introduce submodule changes.
  # Uses the 'siu' git alias (not a bare 'submodule update') for 'with-retry' hang protection --
  # a stalled fetch inside any submodule would otherwise hang this function indefinitely.
  git -C "${target_folder}" siu
  local end_time
  _epoch_seconds end_time
  local duration=$((end_time - start_time))
  debug "Process took ${duration} seconds"
}

# Sets secure permissions on ${HOME}/.ssh (700 on the directory, 600 on all
# files) and adds any bare identity files (id_*) to the ssh-agent keychain.
# Kept in .shellrc for two independent reasons:
#   1. Bootstrap: called in fresh-install-of-osx.sh before install-dotfiles.rb
#      creates the ${ZDOTDIR}/.aliases symlink (vanilla OS pre-symlink window).
#   2. Bash-compat: called from .envrc files (evaluated by direnv in a bash
#      subshell); .aliases contains zsh-only syntax and cannot be sourced in bash.
set_ssh_folder_permissions() {
  info "$(yellow 'Setting ssh config file permissions')"
  ensure_dir_exists "${HOME}/.ssh"
  # Set directory permissions first
  if ! chmod 700 "${HOME}/.ssh"; then
    warn "Failed to set permissions on '$(cyan "${HOME}/.ssh")'"
    return
  fi

  if ! is_directory_empty "${HOME}/.ssh"; then
    if find "${HOME}/.ssh" -type f -exec chmod 600 {} \;; then
      success "Ensured correct permissions for '$(cyan "${HOME}/.ssh")' and files within it."
    else
      warn "Failed to set file permissions in '$(cyan "${HOME}/.ssh")'"
    fi

    # Add keys to ssh-agent and store in macOS Keychain for persistence.
    # --apple-use-keychain (macOS 12+) stores passphrases in Keychain so keys persist
    # across reboots and are available to all processes. Without this, keys are only
    # added to the current ssh-agent session and subprocesses may not have access.
    # Fallback to -K for older macOS versions (deprecated but still works).
    if find "${HOME}/.ssh" -maxdepth 1 -name "id_*" ! -name '*.*' -type f -exec ssh-add --apple-use-keychain "{}" \; 2>/dev/null ||
       find "${HOME}/.ssh" -maxdepth 1 -name "id_*" ! -name '*.*' -type f -exec ssh-add -K "{}" \; 2>/dev/null; then
      success "Added ssh identity files from '$(cyan "${HOME}/.ssh")' to ssh-agent and macOS Keychain."
    else
      warn "Failed to add ssh identity files from '$(cyan "${HOME}/.ssh")'"
    fi
  else
    warn "'$(cyan "${HOME}/.ssh")' exists but is empty. No file permissions to set."
  fi
}

# Runs "$@" and evals its stdout into the current shell environment.
# Silently skips if the command fails or produces no output (stderr suppressed).
# Usage: eval_shellenv <command> [args...]  e.g. eval_shellenv brew shellenv
eval_shellenv() {
  local output
  if output="$("$@" 2>/dev/null)"; then
    eval "${output}"
  fi
}

# --------------------------------------------------------------------------
# 1h. Cron management - bootstrap layer
#
# Contains the primitives needed to safely suspend and resume cron around any
# script that may run before (or during) a fresh install, including before the
# dotfiles repo has been cloned.  These functions only depend on utilities
# already defined in this file (is_file, is_non_empty_file, ensure_dir_exists,
# debug/info/success/warn/error) so they are guaranteed to be available the
# moment .shellrc is sourced on any machine.
#
# The higher-level cron helpers (create_crontab, recron) live in .aliases
# because they reference DOTFILES_DIR, HOMEBREW_PREFIX, and other variables
# that are only meaningful after the dotfiles repo has been cloned and the full
# shell environment has been set up.  See the matching section in .aliases for
# those functions and a fuller explanation of the split.
# --------------------------------------------------------------------------
# Helper functions for delegating to Ruby utilities
# --------------------------------------------------------------------------

# Internal helper: calls a Ruby Cron module method with positional arguments.
# Eliminates duplication of ${LOAD_PATH} setup across cron wrapper functions.
# Usage: _call_ruby_cron <method_name> [args...]
# Example: _call_ruby_cron create_crontab "/path/to/file"
#          _call_ruby_cron recron
_call_ruby_cron() {
  local method="${1:?_call_ruby_cron: method name required}"
  shift

  local args_str=""
  if [[ $# -gt 0 ]]; then
    # Build comma-separated list of single-quoted Ruby string literals.
    local -a args_parts=()
    local arg
    for arg in "$@"; do
      args_parts+=("'${arg}'")
    done
    # Join with ', '
    local IFS=', '
    args_str="${args_parts[*]}"
  fi

  call_ruby_utility "require 'cron'; Cron.${method}(${args_str})"
}

# Loads a cron file into the system crontab. Shared by suspend_cron/resume_cron
# (bootstrap layer, here) and recron (.aliases layer) so neither duplicates logic.
# Thin wrapper that delegates to Ruby Cron.restore_cron.
# Usage: restore_cron <cron-file-path>
restore_cron() {
  _call_ruby_cron restore_cron "$@"
}

# Thin wrapper that delegates to Ruby Cron.suspend_cron.
# Backs up the current crontab to _DOTFILES_CRON_BACKUP_FILE and removes all cron jobs.
suspend_cron() {
  _call_ruby_cron suspend_cron
}

# Thin wrapper that delegates to Ruby Cron.resume_cron.
# Restores crontab from _DOTFILES_CRON_BACKUP_FILE and cleans up the backup file.
resume_cron() {
  _call_ruby_cron resume_cron
}

# --------------------------------------------------------------------------
# 1i. Config reloading (used post-bootstrap to apply changes)
# --------------------------------------------------------------------------

# Reloads zsh configuration files in order (.zshenv -> .zshrc -> .zlogin).
# WARNING: sourcing these files from a context that is itself sourced by them
# can cause infinite loops. Use only for manual post-change reloads or targeted
# bootstrap scenarios (e.g. fresh-install applying new config mid-run).
load_zsh_configs() {
  if (($+functions[is_shellrc_sourced])); then unfunction is_shellrc_sourced; fi
  if (($+functions[is_aliases_sourced])); then unfunction is_aliases_sourced; fi
  # _SCRIPT_NAME is set as a script-scoped global in each script; unset in
  # interactive shells. The fallback makes the caller visible in both contexts.
  debug "load_zsh_configs called from '$(yellow "${_SCRIPT_NAME:-<interactive>}")'"
  local file
  local file_list=('.zshenv' '.zshrc' '.zlogin')
  for file in "${file_list[@]}"; do
    # ${ZDOTDIR} is safe to use here: this function is defined inside .shellrc,
    # so .shellrc must have already run -- and .shellrc initialises ZDOTDIR at
    # line 38 (export ZDOTDIR="${ZDOTDIR:-"${HOME}"}") before this function is
    # ever defined. ZDOTDIR is therefore always set correctly, even in cron or
    # fresh-install subshell contexts where .zshenv has not been sourced.
    debug "load_zsh_configs: loading '$(cyan "${ZDOTDIR}/${file}")'"
    load_file_if_exists "${ZDOTDIR}/${file}"
  done
}

# Prints a standardized usage message and exits.
# Used by scripts in ${DOTFILES_DIR}/scripts/ that may be invoked during fresh-install
# before install-dotfiles.rb has run (e.g. add-upstream-git-config.rb).
# Usage: print_usage <script-name> <option-descriptions...>
#
# Example:
#   print_usage "${0:t}" \
#     "-a <app-name>  --> (mandatory) The application name" \
#     "-v             --> (optional) Verbose output"
print_usage() {
  local script_name="${1:-}"
  shift
  echo "$(red 'Usage'): $(cyan "${script_name}") $(yellow "${1:+"[options]"}")"
  while [[ $# -gt 0 ]]; do
    echo "  ${1:-}"
    shift
  done
  exit 1
}

# Ensure Python history directory exists (self-healing on every shell start).
# Mirrors the pattern in .zshrc for ${HISTFILE:h} (zsh history directory).
# ${var:h} is zsh-only syntax (not bash-compatible), so use ${var%/*} for parent directory.
ensure_dir_exists "${PYTHONHISTORY%/*}"
