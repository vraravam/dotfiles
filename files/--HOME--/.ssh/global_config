# Many other options are described here: https://readmedium.com/using-ssh-every-day-explore-advanced-features-to-simplify-your-routine-94b32e953662

# **IMPORTANT:** SSH config does NOT support bash-style variable expansion like ${VAR:-default}.
# SSH only understands simple ${VAR} or ~ (home directory). Since many tools invoke ssh
# commands without the zsh environment loaded, this file MUST use hardcoded paths like
# ~/.ssh/id_rsa-personal instead of variable references.

# Connection multiplexing for the git hosts: the many sequential git operations (fetch, pull,
# push, submodule updates) reuse one authenticated connection for 120s after the last use instead
# of paying the TCP+SSH handshake every time. 'github-*' / 'gitlab-*' / 'codeberg-*' cover the per-account aliases
# defined in ~/.ssh/config (github-personal, github-work, ...).
# The ControlPath embeds %n (the alias as typed) in addition to the %C hash: every alias resolves to
# the same HostName/port/user, so %C alone would be identical for github-personal and github-work and
# a second account would silently reuse the first account's already-authenticated connection
# (ignoring its IdentityFile). The path stays short (about 75 chars; the unix-socket limit is 104)
# and needs no directory. Hardcoded ~ on purpose -- see the IMPORTANT note above.
# Compression no for the git hosts: git already compresses what it sends (zlib packs), so ssh
# compressing it again saves nothing and only burns CPU on both ends -- measured on a real clone from
# GitHub: 5.1s without vs 5.2s with, identical bytes. ssh uses the FIRST value it finds, so this block
# (above 'Host *') overrides the 'Compression yes' below for these hosts; it also matches the first
# install's bootstrap GIT_SSH_COMMAND, which already sets Compression=no.
Host github.com gitlab.com codeberg.org github-* gitlab-* codeberg-*
  ControlMaster auto
  ControlPath ~/.ssh/cm-%n-%C
  ControlPersist 120
  Compression no

Host *
  AddKeysToAgent yes
  # AllowTcpForwarding yes
  # yes for every other host (the git hosts above override it): interactive shells and file copies to
  # servers over the internet, where compressing text helps on a slow or metered link. Not measured
  # here (git is the only ssh traffic on the machine this was tuned on), so treat it as a reasoned
  # default. Turn it off per host ('Host <fast-lan-host>' / 'Compression no') for already-compressed
  # transfers such as scp of archives or video, or on a fast LAN where it only costs CPU.
  Compression yes
  ConnectionAttempts 3
  # Agent forwarding is OFF (it is also the ssh default; written out so the intent is visible). A
  # forwarded agent gives the remote machine -- and anyone with root on it -- a live socket to every
  # key loaded in your agent for as long as the connection is open (it cannot read the key files, but
  # it can sign as you, e.g. to your git hosts). Git over ssh does not need it: the agent runs on THIS
  # machine. If you genuinely hop through a server, opt in for that host only, in ~/.ssh/config ABOVE
  # the 'Match all' / Include lines (the first value ssh finds wins), e.g.
  #   Host my-bastion
  #     ForwardAgent yes
  # or for a single connection: ssh -A my-bastion
  ForwardAgent no
  IdentitiesOnly yes
  IgnoreUnknown UseKeychain
  ServerAliveCountMax 120
  ServerAliveInterval 30
  # accept-new: an UNKNOWN host's key is accepted and remembered on first connection (so unattended
  # clones, e.g. the first install's ssh remotes, never stop at a yes/no prompt), but a CHANGED key
  # is refused. The former 'no' also connected to a host whose key had changed -- exactly what a
  # man-in-the-middle looks like -- printing only a warning that scripts and cron never show. A host
  # that was legitimately reinstalled (or a cloud IP that now belongs to another instance) needs
  # 'ssh-keygen -R <host>' once, which is the intended signal.
  StrictHostKeyChecking accept-new
  TCPKeepAlive yes
  UseKeychain yes
  # VisualHostKey true
  # X11Forwarding yes
