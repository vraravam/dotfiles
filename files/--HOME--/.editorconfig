# File location: ${HOME}/.editorconfig
# For more info, see docs here: http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

# JSON — no overrides needed except insert_final_newline
# Some tools (api-governance-agent) expect JSON without final newline
[*.json]
insert_final_newline = false

# Markdown — trailing whitespace is semantically significant (two spaces = <br>), so do not
# trim it. Indentation in Markdown is structural (code fences, lists), not a style choice,
# so leave indent_size unset. All other [*] defaults apply.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# Shell scripts
[*.sh]
# shell_variant      = posix # like -ln=posix
# binary_next_line   = true  # like -bn
switch_case_indent = true  # like -ci from shfmt options
space_redirects    = false # like -sr from shfmt options
keep_padding       = true  # like -kp from shfmt options
# function_next_line = true  # like -fn
# never_split        = true  # like -ns

# zsh scripts (by extension) — same shfmt options as .sh
[*.{zsh,zshrc,zshenv,zlogin,zprofile}]
switch_case_indent = true
space_redirects    = false
keep_padding       = true

# Shell dotfiles (no extension) — same shfmt options as .sh
[{.shellrc,.aliases,.profile,.bashrc,.bash_profile,.zshrc,.zshenv,.zlogin,.envrc}]
switch_case_indent = true
space_redirects    = false
keep_padding       = true

# direnv .envrc files are full bash scripts — same shfmt options as .sh
[*.envrc]
switch_case_indent = true
space_redirects    = false
keep_padding       = true

# .env files are KEY=VALUE assignment lists, not shell scripts — no shfmt options apply
# All [*] defaults are correct.

# Windows shell scripts — idiomatically use tabs and CRLF line endings
[*.{cmd,bat}]
indent_style = tab
end_of_line = crlf

# Ruby, Elixir, TOML, YAML, Java, Gradle, Groovy, TypeScript, JavaScript, HTML
# all use 2-space indent from [*] defaults — no overrides needed

# Lockfiles — generated, never hand-edited; no normalisation
# Ruby/Bundler: Gemfile.lock, *.lock
# NPM: package-lock.json, npm-shrinkwrap.json
# Yarn: yarn.lock
# pnpm: pnpm-lock.yaml
# Gradle: gradle.lockfile
# Hex/Elixir: mix.lock
[{*.lock,package-lock.json,npm-shrinkwrap.json,yarn.lock,pnpm-lock.yaml,gradle.lockfile,mix.lock}]
trim_trailing_whitespace = false
insert_final_newline = false
indent_size = unset

# SQL — 4-space indent (sqlfluff, pgFormatter, and most SQL style guides default to 4)
[*.sql]
indent_size = 4

# Python — Black formatter default line length (2-space indent from [*])
[*.py]
max_line_length = 88

# Go — tabs for indentation (Go community standard; gofmt uses tabs)
[*.go]
indent_style = tab

# Makefiles — must use tabs (required by make)
[Makefile]
indent_style = tab
indent_size = unset

# justfile (just command runner) — 4-space indent
[justfile]
indent_size = 4

# gitignore/gitattributes files — columns of patterns use alignment spaces, not indentation
[{.gitignore,.gitignore_global,custom.gitignore,.gitattributes,custom.gitattributes}]
indent_size = unset

# Compiled/binary files — disable all text processing
# zsh bytecode: .zwc, .zwc.old
# Python bytecode: .pyc, .pyo
# Java bytecode: .class
# Native binaries: .o, .so, .dll, .dylib, .exe
# Apple binary plists: .defaults
[*.{zwc,zwc.old,pyc,pyo,class,o,so,dll,dylib,exe,defaults}]
charset = unset
trim_trailing_whitespace = false
insert_final_newline = false
indent_size = unset
