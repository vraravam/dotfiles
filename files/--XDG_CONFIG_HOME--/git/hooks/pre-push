#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# Global pre-push hook that runs before every 'git push' in any repository.
# Installed via core.hooksPath in .gitconfig.
#
# Execution order:
#   1. Repo-specific hook (.git/hooks.local/pre-push) if exists
#   2. Per-repo customization (${PERSONAL_BIN_DIR}/pre-push-<basename>.rb or .sh) if exists
#
# This hook receives arguments from git:
#   $1 = remote name (e.g., 'origin')
#   $2 = remote URL
#
# Standard input provides refs being pushed:
#   <local ref> <local sha1> <remote ref> <remote sha1>
#
# The logic lives in scripts/utilities/git_hooks.rb. The path below is resolved relative
# to this file's real location (require_relative follows the core.hooksPath symlink).

require_relative '../../../../scripts/utilities/git_hooks'

exit(GitHooks.pre_push(ARGV) ? 0 : 1)
