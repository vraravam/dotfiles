#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# Global pre-commit hook that runs before every 'git commit' in any repository.
# Installed via core.hooksPath in .gitconfig.
#
# Checks (in order):
#   1. Ruby syntax validation (/usr/bin/ruby -c) on all staged .rb files
#   2. Shell syntax validation (zsh -n) on all staged shell files
#   3. RuboCop static analysis on staged .rb files (if installed)
#   4. Repo-specific hook (.git/hooks.local/pre-commit) if exists
#   5. Per-repo customization (${PERSONAL_BIN_DIR}/pre-commit-<basename>.rb or .sh) if exists
#
# To skip these checks: git commit --no-verify
#
# The logic lives in scripts/utilities/git_hooks.rb. The path below is resolved relative
# to this file's real location (require_relative follows the core.hooksPath symlink).

require_relative '../../../../scripts/utilities/git_hooks'

exit(GitHooks.pre_commit(ARGV) ? 0 : 1)
