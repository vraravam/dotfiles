#!/usr/bin/env zsh

# vim:filetype=zsh syntax=zsh tabstop=2 shiftwidth=2 softtabstop=2 expandtab autoindent fileencoding=utf-8

# git command: push

# Re-source guard is inside .shellrc itself -- safe to call unconditionally.
source "${HOME}/.shellrc"

_push() {
  local folder
  local -a switches
  parse_folder_and_switches "$@"
  # Only show section_header when called directly (not from wrapper scripts).
  # Wrapper scripts use print_script_start for their own headers.
  if [[ "${_DOTFILES_SCRIPT_DEPTH:-0}" -le 0 ]]; then
    section_header "$(yellow 'Pushing') '$(cyan "${folder}")'"
  fi
  if ! is_git_repo "${folder}"; then
    warn "Skipping pushing of the repo since '$(cyan "${folder}")' doesn't exist or is not a git repo"
  else
    # Skip git alias override detection to prevent double-execution when called
    # from wrapper scripts (dispatch_or_fallback already found the override).
    # Wrapped in 'git with-retry' (not a bare 'git push') for hang protection -- 'git push'
    # is a builtin and always wins over the same-named git alias (confirmed empirically;
    # see the NOTE on the (removed) 'push' alias in git/config), so this is the one place
    # that actually needs to add retry protection for the bare 'push' command. Uses '-' for
    # the progress-path (plain wall-clock timeout, not inactivity-based): unlike fetch/pull/
    # backfill, a push doesn't write new objects to the LOCAL '.git/objects' as it progresses
    # (it reads local objects and sends them to the remote), so there's no natural on-disk
    # growth signal to poll here.
    _GIT_OVERRIDE_SKIP=1 git with-retry 60 3 /dev/null - git -C "${folder}" push "${switches[@]}" || true
  fi
}

push() {
  # Guard against race condition when .aliases is deferred via zsh-defer: if
  # dispatch_or_fallback doesn't exist yet (multiple tabs opening simultaneously),
  # load .aliases synchronously now. The re-source guard in .aliases makes this safe.
  if ! (($+functions[dispatch_or_fallback])); then
    source "${ZDOTDIR}/.aliases"
  fi
  dispatch_or_fallback push _push "$@"
}

# Run only when executed directly, not when sourced (e.g. to import the function into another script).
# Pattern matches both 'file' (regular sourcing) and 'filecode' (.zwc bytecode).
[[ ":${ZSH_EVAL_CONTEXT}:" == *:file(|code):* ]] || push "$@"

# is_zsh returns false in bash (ZSH_VERSION unset), short-circuiting the zsh-only
# '(( $+functions[...] ))' syntax so it is never evaluated by non-zsh runtimes.
is_zsh && (($+functions[compdef])) && compdef push || true
