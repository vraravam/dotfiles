#!/usr/bin/env zsh

# vim:filetype=zsh syntax=zsh tabstop=2 shiftwidth=2 softtabstop=2 expandtab autoindent fileencoding=utf-8

# git command: pull

# Re-source guard is inside .shellrc itself -- safe to call unconditionally.
source "${HOME}/.shellrc"

_pull() {
  local folder
  local -a switches
  parse_folder_and_switches "$@"
  section_header "$(yellow 'Pulling') '$(cyan "${folder}")'"
  if ! is_git_repo "${folder}"; then
    warn "Skipping pulling of the repo since '$(cyan "${folder}")' doesn't exist or is not a git repo"
    return 0
  fi

  # Skip git alias override detection to prevent double-execution when called
  # from wrapper scripts (dispatch_or_fallback already found the override).
  # Wrapped in 'git with-retry' (not a bare 'git pull') for hang protection -- 'git pull'
  # is a builtin and always wins over the same-named git alias (confirmed empirically;
  # see the WARNING comment on the 'pull' alias in git/config), so this is the one place
  # that actually needs to add retry protection for the bare 'pull' command. Deliberately
  # NOT 'pull-safe' here (unlike the fallback below) -- 'pull-safe' is designed for
  # unattended/cron use and refuses outright on a dirty tree, whereas this primary,
  # interactive path benefits from this repo's own '[merge]/[rebase] autoStash = true'
  # (stash-pull-pop transparently); routing the common case through 'pull-safe' would
  # regress that convenience for every interactive 'pull' call, not just diverged ones.
  if _GIT_OVERRIDE_SKIP=1 git with-retry 60 3 /dev/null "${folder}/.git/objects" git -C "${folder}" pull "${switches[@]}"; then
    return 0
  fi

  # 'with-retry' can't fix a pull failing because the local and remote histories have
  # diverged with no common ancestor (e.g. after recreate-repository.rb force-squashes
  # a repo -- see KeybaseMigration.md) -- that's a content problem, not a network one,
  # and retrying the same 'git pull' would just fail identically every time. Repos that
  # expect this (browser-profiles) opt in with:
  #   git config --local pull.allowResetOnDivergedHistory true
  # Everywhere else (the default), a failed pull is reported and left alone -- matches
  # the previous behavior of this function, which silently swallowed any pull failure.
  if [[ "$(git -C "${folder}" config --type=bool --default false pull.allowResetOnDivergedHistory)" != 'true' ]]; then
    return 0
  fi

  # 'pull-safe' (git/config) already implements the exact fetch + clean-check +
  # rebase-or-reset-on-diverged-history workflow needed here -- reused directly
  # instead of a second, Ruby-only reimplementation (previously
  # GitProcessor#pull_or_reset, called here via a 'call_ruby_utility' subprocess
  # hop). 'pull-safe' does its own 'fo' fetch (with-retry + promisor-first
  # ordering) and its own is-clean guard, so this is a complete, self-contained
  # recovery attempt on its own -- not merely "finish what the failed bare pull
  # above started".
  info "Pull failed -- '$(cyan "${folder}")' has 'pull.allowResetOnDivergedHistory' set; checking for diverged history"
  if ! _GIT_OVERRIDE_SKIP=1 git -C "${folder}" pull-safe; then
    _record_warning "Failed to reconcile '$(cyan "${folder}")' -- see errors above"
  fi
}

pull() {
  # Guard against race condition when .aliases is deferred via zsh-defer: if
  # dispatch_or_fallback doesn't exist yet (multiple tabs opening simultaneously),
  # load .aliases synchronously now. The re-source guard in .aliases makes this safe.
  if ! (($+functions[dispatch_or_fallback])); then
    source "${ZDOTDIR}/.aliases"
  fi
  dispatch_or_fallback pull _pull "$@"
}

# Run only when executed directly, not when sourced (e.g. to import the function into another script).
# Pattern matches both 'file' (regular sourcing) and 'filecode' (.zwc bytecode).
[[ ":${ZSH_EVAL_CONTEXT}:" == *:file(|code):* ]] || pull "$@"

# is_zsh returns false in bash (ZSH_VERSION unset), short-circuiting the zsh-only
# '(( $+functions[...] ))' syntax so it is never evaluated by non-zsh runtimes.
is_zsh && (($+functions[compdef])) && compdef pull || true
