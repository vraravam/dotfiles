#!/usr/bin/env zsh

# vim:filetype=zsh syntax=zsh tabstop=2 shiftwidth=2 softtabstop=2 expandtab autoindent fileencoding=utf-8

# git command: pull

# Re-source guard is inside .shellrc itself -- safe to call unconditionally.
source "${HOME}/.shellrc"

_pull() {
  local folder
  local -a switches
  parse_folder_and_switches "$@"
  section_header "$(yellow 'Pulling') '$(cyan "${folder}")'"
  if ! is_git_repo "${folder}"; then
    warn "Skipping pulling of the repo since '$(cyan "${folder}")' doesn't exist or is not a git repo"
  else
    # Skip git alias override detection to prevent double-execution when called
    # from wrapper scripts (dispatch_or_fallback already found the override).
    # Wrapped in 'git with-retry' (not a bare 'git pull') for hang protection -- 'git pull'
    # is a builtin and always wins over the same-named git alias (confirmed empirically;
    # see the WARNING comment on the 'pull' alias in git/config), so this is the one place
    # that actually needs to add retry protection for the bare 'pull' command.
    _GIT_OVERRIDE_SKIP=1 git with-retry 60 3 /dev/null "${folder}/.git/objects" git -C "${folder}" pull "${switches[@]}" || true
  fi
}

pull() {
  # Guard against race condition when .aliases is deferred via zsh-defer: if
  # dispatch_or_fallback doesn't exist yet (multiple tabs opening simultaneously),
  # load .aliases synchronously now. The re-source guard in .aliases makes this safe.
  if ! (($+functions[dispatch_or_fallback])); then
    source "${ZDOTDIR}/.aliases"
  fi
  dispatch_or_fallback pull _pull "$@"
}

# Run only when executed directly, not when sourced (e.g. to import the function into another script).
# Pattern matches both 'file' (regular sourcing) and 'filecode' (.zwc bytecode).
[[ ":${ZSH_EVAL_CONTEXT}:" == *:file(|code):* ]] || pull "$@"

# is_zsh returns false in bash (ZSH_VERSION unset), short-circuiting the zsh-only
# '(( $+functions[...] ))' syntax so it is never evaluated by non-zsh runtimes.
is_zsh && (($+functions[compdef])) && compdef pull || true
