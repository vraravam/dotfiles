#!/bin/sh

# file location: ${DOTFILES_DIR}/scripts/git-backfill-blobs
#
# External git subcommand: git runs this as 'git backfill-blobs' (any 'git-<name>' executable on PATH
# is a subcommand). Plain /bin/sh and dependency-free on purpose -- no .shellrc -- so it works
# from cron and before the dotfiles shell environment exists.
#
# Backfills any missing blob objects if the repo is a partial/blobless clone
# (--filter=blob:none). Fetching full commit/tree history (via 'git fo') does NOT
# fetch blob content -- these are two independent axes, so this is a separate step.
# No-op if not a partial clone, or if the installed git version predates 'git
# backfill' (2.44+). Run this AFTER 'git fo' has fetched from the promisor remote --
# backfilling against stale/incomplete history would be wasted work.
#
# No-op guard: checks for any object still missing from HEAD's own reachable
# history (via 'rev-list --objects HEAD --missing=print', the same technique 'git
# st' already uses with --all) before doing any of the work below, and exits
# immediately if there's nothing left. Callers such as 'git unshallow' invoke this
# on every run with no memory of a previous successful backfill -- without this
# check, a repo that's already fully backfilled would still pay for the full
# chunked walk-and-fetch dance below (same commit-count math, same 5 retried
# remote round-trips) on every single invocation, forever, even though 'git
# backfill' itself has nothing left to actually transfer.
#
# Backfills in up to 5 chunks (fewer for a repo with under 5 commits), newest
# history first, rather than one single 'git backfill' call across all of HEAD.
# 'git backfill' groups every historical blob at a given path into one batch
# regardless of --min-batch-size (per git-backfill(1): batch size "may be exceeded
# by the last set of blobs seen at a given path") -- a single path with many large
# historical versions (e.g. a binary committed directly) can therefore produce one
# multi-GB, unsplittable transfer that a flaky connection can never complete, since
# a failed 'index-pack' discards all progress and the next retry re-requests the
# exact same oversized batch from scratch. Splitting the commit range into chunks
# bounds how many historical versions of any one path fall into a single 'git
# backfill' invocation, so the same oversized path's blobs are spread across
# several smaller, actually-transferable batches instead of one unbatchable one.
# Commit boundaries come from 'git rev-list --count'/'--reverse' against the LOCAL
# repo, not the remote -- a blobless partial clone already has full commit/tree
# history (only blobs are filtered), so this needs no extra network round-trip.
# Each chunk is wrapped in 'with-retry' exactly as the single-call version was; if
# a chunk exhausts its retries, the loop stops (older chunks are skipped) rather
# than pressing on -- the skipped history's blobs simply lazy-fetch on demand
# later, the same fallback already used when backfill fails entirely.
#
# The chunk loop above only ever walks HEAD's own ancestry ('rev-list --reverse
# HEAD'), so a blob reachable only from some other ref (a tag, a remote-tracking
# branch never checked out locally, etc.) is invisible to it. After the HEAD-scoped
# chunks finish (and are skipped entirely by the no-op guard above), a final
# unchunked 'git backfill --all' pass mops up anything still missing across every
# ref -- itself skipped via the same missing=print check if there's nothing left.
# Deliberately not chunked like the HEAD pass above: by this point only the
# handful of blobs unique to non-HEAD refs remain, not the full repository
# history, so the oversized-single-batch risk the chunking exists to avoid doesn't
# apply here.
# Usage: git backfill-blobs [<dir>]

# Git ran the former alias from the work tree's top level; an external command runs from the
# caller's directory, so the default directory is the top level (not '.') to keep
# 'git backfill-blobs' from a subdirectory working the same way.

main() {
  dir="${1:-$(git rev-parse --show-toplevel 2>/dev/null || printf .)}"
  if [ "$(git -C "${dir}" config --get remote.origin.promisor 2>/dev/null)" != 'true' ]; then
    exit 0
  fi
  if git backfill -h 2>&1 | grep -q 'is not a git command'; then
    printf 'Skipping blob backfill -- installed git version predates git backfill (needs 2.44+)\n' >&2
    exit 0
  fi
  chunk_failed=0
  if [ -z "$(git -C "${dir}" rev-list --objects HEAD --missing=print 2>/dev/null | grep '^?')" ]; then
    printf 'No missing blob objects reachable from HEAD -- nothing to backfill.\n'
  else
    total=$(git -C "${dir}" rev-list --count HEAD 2>/dev/null)
    if [ -z "${total}" ] || [ "${total}" -le 0 ]; then
      printf 'Skipping blob backfill -- could not determine commit history\n' >&2
    else
      chunks=5
      if [ "${total}" -lt "${chunks}" ]; then chunks="${total}"; fi
      seg_size=$(((total + chunks - 1) / chunks))
      commits_file="$(mktemp)"
      git -C "${dir}" rev-list --reverse HEAD >"${commits_file}"
      printf 'Backfilling missing blob objects in %s chunk(s) (partial clone, %s commits total, newest first)...\n' "${chunks}" "${total}"
      i="${chunks}"
      while [ "${i}" -ge 1 ]; do
        end_line=$((i * seg_size))
        if [ "${end_line}" -gt "${total}" ]; then end_line="${total}"; fi
        start_line=$(((i - 1) * seg_size))
        end_sha=$(sed -n "${end_line}p" "${commits_file}")
        if [ "${start_line}" -gt 0 ]; then
          start_sha=$(sed -n "${start_line}p" "${commits_file}")
          range="${start_sha}..${end_sha}"
        else
          range="${end_sha}"
        fi
        printf 'Backfill chunk %s/%s (commits %s-%s of %s)...\n' "${i}" "${chunks}" "$((start_line + 1))" "${end_line}" "${total}" >&2
        backfill_stderr="$(mktemp)"
        if git with-retry 90 5 "${backfill_stderr}" "${dir}/.git/objects" git -C "${dir}" backfill --min-batch-size=500 "${range}"; then
          printf 'Chunk %s/%s backfilled.\n' "${i}" "${chunks}"
          rm -f "${backfill_stderr}"
        else
          printf 'Warning: could not backfill chunk %s/%s after retries -- stopping (remaining older history will lazy-fetch on demand). Last error:\n' "${i}" "${chunks}" >&2
          cat "${backfill_stderr}" >&2
          rm -f "${backfill_stderr}"
          chunk_failed=1
          break
        fi
        i=$((i - 1))
      done
      rm -f "${commits_file}"
      if [ "${chunk_failed}" -eq 0 ]; then printf 'Backfill complete.\n'; fi
    fi
  fi
  if [ "${chunk_failed}" -eq 0 ]; then
    remaining=$(git -C "${dir}" rev-list --objects --all --missing=print 2>/dev/null | grep '^?')
    if [ -n "${remaining}" ]; then
      count=$(printf '%s\n' "${remaining}" | wc -l | xargs)
      printf 'Backfilling %s remaining blob object(s) outside HEAD (other branches/tags)...\n' "${count}"
      backfill_stderr2="$(mktemp)"
      if git with-retry 90 5 "${backfill_stderr2}" "${dir}/.git/objects" git -C "${dir}" backfill --min-batch-size=500 --all; then
        printf 'Remaining backfill complete.\n'
      else
        printf 'Warning: could not backfill remaining objects after retries. Last error:\n' >&2
        cat "${backfill_stderr2}" >&2
      fi
      rm -f "${backfill_stderr2}"
    fi
  fi
}

main "$@"
