#!/bin/sh

# file location: ${DOTFILES_DIR}/scripts/wait-editor
#
# Thin wrapper used as $EDITOR for tools (crontab, visudo, fc, etc.) that
# exec() the editor directly without shell parsing.  Those tools can only pass
# a bare binary name -- no flags.  This wrapper re-execs $GIT_EDITOR, which
# carries the full invocation including --wait (e.g. 'code --wait'), so the
# calling tool blocks until the editor window is closed.
#
# Must remain a standalone executable file -- can NEVER be a shell function.
# crontab/visudo/fc are separate processes (or zsh's own fc builtin doing its
# own fork+exec) that read $EDITOR and either execvp() it directly, or fork a
# fresh 'sh -c "$EDITOR ..."' subprocess.  Either way that is a brand-new
# process with zero visibility into any interactive shell's function table --
# a function only exists in the memory of the shell that defined it, never on
# disk, so it can never be found via a PATH lookup by an unrelated process.
# Whatever $EDITOR holds must always resolve to a real, PATH-findable file.
#
# Intentional unquoted expansion of $GIT_EDITOR: we rely on POSIX word-
# splitting so that 'code --wait' becomes two separate exec() arguments.
# shellcheck disable=SC2086
exec ${GIT_EDITOR:?GIT_EDITOR is not set -- cannot open editor in wait mode} "$@"
