#!/bin/sh

# file location: ${DOTFILES_DIR}/scripts/git-pull-safe
#
# External git subcommand: git runs this as 'git pull-safe' (any 'git-<name>' executable on PATH
# is a subcommand). Plain /bin/sh and dependency-free on purpose -- no .shellrc -- so it works
# from cron and before the dotfiles shell environment exists.
#
# Fetches all remotes, then rebases onto @{u} only if the working tree is clean
# (no uncommitted or staged changes). If the tree is dirty, skips the rebase,
# prints a message to stderr, and exits non-zero -- callers such as run-all.rb
# surface this as a per-repo warning so the user knows to pull manually.
# Designed for cron: a dirty skip is surfaced as a warning, not silently dropped.
# Uses 'git fo' (not a bare 'git fetch') for the same reason every other git command in
# this config does: hang protection via 'with-retry' and promisor-first remote
# ordering for partial/blobless clones -- a bare 'git fetch' here would bypass both.
#
# If the rebase target has no common ancestor with the current branch (e.g. after
# a remote force-squash -- see recreate-repository.rb/KeybaseMigration.md), a plain
# rebase is meaningless (there is no shared base to replay onto). By default this
# is treated as an error (unexpected -- refuses to silently discard local commits).
# Repos that expect this can opt in with:
#   git config --local pull.allowResetOnDivergedHistory true
# in which case a diverged history instead falls back to a hard reset onto @{u}.
# This absorbs what was previously a separate, Ruby-only code path
# (GitProcessor#pull_or_reset) -- both GitCommands.pull (for the bare
# 'git pull' case, which can't use this command directly -- see the WARNING above)
# and GitProcessor#pull (which already called this command) now get the same
# diverged-history recovery for free from this one implementation, instead of
# a second, independent reimplementation existing only in Ruby with its own
# (non-'fo', non-retry-protected) fetch step.
# Usage: git pull-safe [<dir>]

# Git ran the former alias from the work tree's top level; an external command runs from the
# caller's directory, so the default directory is the top level (not '.') to keep
# 'git pull-safe' from a subdirectory working the same way.

main() {
  dir="${1:-$(git rev-parse --show-toplevel 2>/dev/null || printf .)}"
  git -C "${dir}" fo
  if ! git -C "${dir}" is-clean; then
    printf 'Skipping rebase in %s: working tree has uncommitted changes. Pull manually.\n' "${dir}" >&2
    exit 1
  fi
  branch=$(git -C "${dir}" br)
  if [ -z "${branch}" ]; then
    printf 'Could not determine current branch in %s\n' "${dir}" >&2
    exit 1
  fi
  if git -C "${dir}" merge-base "${branch}" '@{u}' >/dev/null 2>&1; then
    git -C "${dir}" rebase '@{u}'
    exit $?
  fi
  allow_reset=$(git -C "${dir}" config --type=bool --default false pull.allowResetOnDivergedHistory)
  if [ "${allow_reset}" != 'true' ]; then
    printf '%s and @{u} have no common ancestor in %s (unexpected -- was history rewritten upstream?) -- refusing to rebase blindly\n' "${branch}" "${dir}" >&2
    exit 1
  fi
  printf '%s and @{u} have no common ancestor in %s (expected after a force-squash) -- resetting %s to @{u} instead of rebasing\n' "${branch}" "${dir}" "${branch}" >&2
  git -C "${dir}" reset --hard '@{u}'
}

main "$@"
