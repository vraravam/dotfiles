#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# file location: ${DOTFILES_DIR}/scripts/git-remote-encrypted-backup
#
# NOTE ON FILENAME: git mandates an exact, extensionless name of the form
# 'git-remote-<transport>' for remote-helper dispatch (see 'man gitremote-helpers'
# INVOCATION) -- this is the one script in this repo that cannot follow the usual
# kebab-case-with-extension convention (ruby-scripting.md, File Naming Convention section).
#
# Custom git remote helper exposing the gpg+git-bundle encrypted backup mechanism
# (scripts/utilities/encrypted_backup.rb) as a real git remote, so plain 'git pull'/
# 'git push'/'git fetch' work seamlessly -- no shell wrapper, no manual bundle/encrypt/
# decrypt steps, no push-<basename>.sh override script involved at all. Git invokes
# this automatically for any remote URL of the form 'encrypted-backup::<repo-name>'.
#
# Designed to coexist with a real remote (e.g. a keybase:// 'origin'), not replace it --
# see KeybaseMigration.md. Add it as a second, separately-named remote:
#   git remote add encrypted-backup encrypted-backup::home
#   git fetch encrypted-backup
#   git pull encrypted-backup
#   git push encrypted-backup
#
# Protocol summary (see 'man gitremote-helpers' for the authoritative spec):
#   capabilities        -> this helper supports 'fetch', 'push', and 'option'.
#   option verbosity <n> / option progress {true|false} -> stored (see _reply_option) and
#     threaded through to EncryptedBackup.bundle_and_push/fetch_and_list_bundle_refs's
#     'quiet:' parameter (see _quiet?), so 'git push -q'/'git fetch -q' (verbosity 0) or an
#     explicit 'option progress false' suppress 'git bundle create'/'unbundle's progress
#     meter, and the default (verbosity 1, no progress option) forces it on explicitly --
#     see EncryptedBackup.bundle_and_push's doc for why this is forced rather than left to
#     git's own tty auto-detection. Any other option name replies 'unsupported' (per spec).
#   list / list for-push -> fetches + decrypts the latest backup, imports its objects
#     into GIT_DIR, and reports the ref list it contains (see
#     EncryptedBackup.fetch_and_list_bundle_refs). Since decryption is all-or-nothing,
#     this eagerly imports everything up front -- there is no cheaper way to answer
#     'list' alone.
#   fetch <sha1> <name> -> objects are already present from the 'list' call above;
#     this just acknowledges the batch (see 'fetch' capability semantics: the helper
#     is only responsible for populating the object database -- git itself updates
#     remote-tracking refs afterward from the 'list' output).
#   push +<src>:<dst>   -> bundles ALL local refs (not just the ones in this batch --
#     matches the rest of this codebase's 'whole-repo backup' design, see
#     EncryptedBackup.bundle_and_push) and pushes the result. Reports 'ok' for every
#     ref in the batch once that single push succeeds.
#
# CRITICAL: the wire protocol is carried entirely over this process's stdout/stdin.
# Every internal Logging.info/success/debug/warn call in EncryptedBackup and its
# dependencies (GitProcessor, CommandUtils) writes to Ruby's $stdout via 'puts' --
# and CommandUtils.run_interactive shells out via a bare 'system(*command)', which
# inherits the real OS file descriptor 1 directly (unaffected by reassigning Ruby's
# $stdout object). Reassigning '$stdout = $stderr' alone would therefore NOT stop a
# subprocess (e.g. 'git clone' progress output during a wrapper-repo pull) from
# corrupting the protocol stream. _with_stdout_redirected_to_stderr below uses
# 'IO#reopen', a real dup2()-level file descriptor redirect, so it silences both
# Ruby-level puts calls AND anything a child process writes to its inherited fd 1.
#
# Known limitation shared with git-remote-gcrypt (see its own docs): every push
# replaces the entire backup, so there is no server-side "reject non-fast-forward"
# check the way a real git server provides. Git's own pre-push fast-forward check
# (based on the 'list for-push' output above) still applies -- fetch/pull before
# pushing, as always.

require 'pathname'

SCRIPT_DIR = Pathname.new(__dir__).expand_path.freeze
require_relative SCRIPT_DIR.join('utilities', 'core').to_s
require_relative SCRIPT_DIR.join('utilities', 'encrypted_backup').to_s

module GitRemoteEncryptedBackup
  extend self
  extend Core

  CAPABILITIES = %w[fetch push option].freeze

  # @param address [String] the repo name after '::' in the remote URL (e.g. 'home')
  # @return [Boolean] true on success
  def run(address:)
    git_dir = ENV.fetch('GIT_DIR', nil)
    if nil_or_empty?(git_dir)
      warn 'git-remote-encrypted-backup: GIT_DIR not set -- must be invoked by git itself'
      return false
    end

    $stdout.sync = true

    loop do
      line = $stdin.gets
      break if line.nil?

      line = line.chomp
      case line
      when 'capabilities'
        _reply_capabilities
      when 'list', 'list for-push'
        _reply_list(git_dir: git_dir, encrypted_repo_name: address)
      when /\Afetch /
        _consume_fetch_batch
      when /\Apush /
        _reply_push(line, git_dir: git_dir, encrypted_repo_name: address)
      when /\Aoption /
        _reply_option(line)
      when ''
        break
      else
        warn "git-remote-encrypted-backup: unknown command '#{line}'"
      end
    end
    true
  end

  # Redirects the real OS file descriptor for stdout to stderr for the duration of the
  # block -- see the file header comment for why '$stdout = $stderr' alone is not
  # sufficient. Always restores the original fd afterward, even on error.
  #
  # @return the block's return value
  def _with_stdout_redirected_to_stderr
    original_stdout_fd = $stdout.dup
    $stdout.reopen($stderr)
    yield
  ensure
    $stdout.reopen(original_stdout_fd)
    original_stdout_fd.close
  end

  def _reply_capabilities
    CAPABILITIES.each { |c| puts c }
    puts ''
  end

  # Handles 'option <name> <value>' (see the OPTIONS section of 'man gitremote-helpers').
  # Only 'verbosity' and 'progress' are recognized (both stored for _quiet? to combine
  # below) -- any other option name is unsupported per spec (git itself only sends
  # options relevant to the capabilities a helper advertises, so depth/dry-run/etc. are
  # never actually sent to a helper that only advertises 'fetch'/'push'/'option').
  def _reply_option(line)
    name, value = line.sub(/\Aoption /, '').split(' ', 2)
    case name
    when 'verbosity'
      @verbosity = value.to_i
      puts 'ok'
    when 'progress'
      @progress = (value == 'true')
      puts 'ok'
    else
      puts 'unsupported'
    end
  end

  # Combines the two options _reply_option may have stored into a single 'quiet:' bool
  # for EncryptedBackup.bundle_and_push/fetch_and_list_bundle_refs. An explicit 'option
  # progress' always wins (it is the more specific of the two); otherwise falls back to
  # verbosity (0 = quiet per spec; unset defaults to 1 = not quiet).
  def _quiet?
    return !@progress if defined?(@progress) && !@progress.nil?

    (@verbosity || 1) < 1
  end

  def _reply_list(git_dir:, encrypted_repo_name:)
    refs = _with_stdout_redirected_to_stderr do
      EncryptedBackup.fetch_and_list_bundle_refs(git_dir: git_dir, encrypted_repo_name: encrypted_repo_name, quiet: _quiet?)
    end
    refs.each { |sha1, ref| puts "#{sha1} #{ref}" }
    puts ''
  end

  # Objects are already imported into GIT_DIR by the preceding 'list' call (see the
  # 'fetch' capability semantics in the file header comment) -- just consume the
  # batch of 'fetch <sha1> <name>' lines and acknowledge with a blank line.
  def _consume_fetch_batch
    loop do
      line = $stdin.gets
      break if line.nil? || line.chomp.empty?
    end
    puts ''
  end

  def _reply_push(first_line, git_dir:, encrypted_repo_name:)
    refspecs = [first_line]
    loop do
      line = $stdin.gets
      break if line.nil?

      line = line.chomp
      break if line.empty?

      refspecs << line
    end

    success = _with_stdout_redirected_to_stderr do
      EncryptedBackup.bundle_and_push(git_dir: git_dir, encrypted_repo_name: encrypted_repo_name, quiet: _quiet?)
    end

    refspecs.each do |refspec|
      _, dst = refspec.sub(/\Apush /, '').split(':', 2)
      puts(success ? "ok #{dst}" : "error #{dst} encrypted-backup push failed -- see stderr above")
    end
    puts ''
  end

  private_class_method :_with_stdout_redirected_to_stderr, :_reply_capabilities, :_reply_option, :_quiet?,
                       :_reply_list, :_consume_fetch_batch, :_reply_push
end

if __FILE__ == $PROGRAM_NAME
  # ARGV[0] is the remote name (or, per 'man gitremote-helpers', the raw URL when used
  # ad hoc rather than via a configured remote); ARGV[-1] is always the address --
  # verified empirically against real git invocations (both 'git ls-remote
  # encrypted-backup::home' and a configured 'git remote add' + 'git fetch').
  success = GitRemoteEncryptedBackup.run(address: ARGV[-1].to_s)
  exit(success ? 0 : 1)
end
