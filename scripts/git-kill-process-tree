#!/bin/sh

# file location: ${DOTFILES_DIR}/scripts/git-kill-process-tree
#
# External git subcommand: git runs this as 'git kill-process-tree' (any 'git-<name>' executable on PATH
# is a subcommand). Plain /bin/sh and dependency-free on purpose -- no .shellrc -- so it works
# from cron and before the dotfiles shell environment exists.
#
# Kills a process and all of its descendants. A plain 'kill -9 $pid' only kills
# the direct process -- if it has already spawned children (e.g. a stalled git
# command that spawned an ssh or git-remote-https helper subprocess), those
# children become orphans and keep running indefinitely. Used by 'with-retry'
# to fully clean up a stalled command tree before retrying. Recurses via 'git
# kill-process-tree' rather than a shell function so it stays a self-contained
# git subcommand, callable from any other script or alias without sourcing external files.
# Usage: git kill-process-tree <pid>

main() {
  pid="${1:?kill-process-tree: pid required}"
  for child in $(pgrep -P "${pid}" 2>/dev/null); do
    git kill-process-tree "${child}"
  done
  kill -9 "${pid}" 2>/dev/null || true
}

main "$@"
