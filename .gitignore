# file location: ${DOTFILES_DIR}/.gitignore

*.zwc*
.*.zwc*
/.ruby-lsp/*

# Local rubocop install (see Gemfile -- pinned for CI/local lint tooling)
/vendor/
/.bundle/

# SimpleCov output (see spec/spec_helper.rb) -- regenerated by every 'bundle exec rspec' run
/coverage/

# Session-specific work products (transactional, no long-term value)
/.ai/session-state/

# Force-include .envrc (overrides global gitignore pattern .env*)
# This repository's .envrc is shared configuration, not user-specific
!/.envrc
!/files/--ZDOTDIR--/lib/
